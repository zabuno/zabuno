APP_NAME=Zabuno
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

IYZICO_MODE=sandbox
BILLING_SUBSCRIPTION_PERIOD_DAYS=30
# FATURA (FF-215, docs/130) — İKİSİ DE BİLEREK BOŞ.
# Seri harfleri: boşken belge numarası "2026-000001" olur. Uydurulmuş üç
# harf, GİB'in e-arşiv seri biçimini taklit ederdi.
BILLING_INVOICE_NUMBER_PREFIX=
# KDV oranı ONBİNDE (%20 -> 2000). Boşken belge vergi ayrımı GÖSTERMEZ;
# bir oran varsayılmaz. Doldurmak, plan fiyatlarının bu oranda KDV DAHİL
# olduğunu beyan etmektir.
BILLING_INVOICE_VAT_RATE_BASIS_POINTS=
IYZICO_SANDBOX_API_KEY=
IYZICO_SANDBOX_SECRET_KEY=
IYZICO_SANDBOX_BASE_URL=https://sandbox-api.iyzipay.com
IYZICO_SANDBOX_PROFILE_BUYER_ID=
IYZICO_SANDBOX_PROFILE_BUYER_NAME=
IYZICO_SANDBOX_PROFILE_BUYER_SURNAME=
IYZICO_SANDBOX_PROFILE_BUYER_EMAIL=
IYZICO_SANDBOX_PROFILE_BUYER_IDENTITY_NUMBER=
IYZICO_SANDBOX_PROFILE_BUYER_REGISTRATION_ADDRESS=
IYZICO_SANDBOX_PROFILE_BUYER_CITY=
IYZICO_SANDBOX_PROFILE_BUYER_COUNTRY=
IYZICO_SANDBOX_PROFILE_BUYER_ZIP_CODE=
IYZICO_SANDBOX_PROFILE_BUYER_IP=
IYZICO_SANDBOX_PROFILE_BILLING_CONTACT_NAME=
IYZICO_SANDBOX_PROFILE_BILLING_CITY=
IYZICO_SANDBOX_PROFILE_BILLING_COUNTRY=
IYZICO_SANDBOX_PROFILE_BILLING_ADDRESS=
IYZICO_SANDBOX_PROFILE_BILLING_ZIP_CODE=
IYZICO_SANDBOX_PROFILE_SHIPPING_CONTACT_NAME=
IYZICO_SANDBOX_PROFILE_SHIPPING_CITY=
IYZICO_SANDBOX_PROFILE_SHIPPING_COUNTRY=
IYZICO_SANDBOX_PROFILE_SHIPPING_ADDRESS=
IYZICO_SANDBOX_PROFILE_SHIPPING_ZIP_CODE=

# --- Yerel geliştirme dayanıklılığı -------------------------------------
# Yerel SQLite veritabanını worktree'lerin DIŞINDA, kalıcı bir yolda tutun.
# Worktree silindiğinde/yeniden kurulduğunda hesaplar ve test verisi kaybolmaz.
# Örnek: DB_DATABASE=/Users/<siz>/.zabuno/local-dev.sqlite
# DB_DATABASE=

# Yerel QA hesabı. Verilirse `migrate:fresh --seed` hesabı otomatik geri kurar.
# Parolayı buraya yazmak zorunda değilsiniz: macOS'ta
# scripts/restore-local-test-account.sh bunları Keychain'den doldurur.
# Yerel olmayan ortamlarda seeder çalışmayı reddeder.
# LOCAL_TEST_ACCOUNT_EMAIL=
# LOCAL_TEST_ACCOUNT_PASSWORD=
# LOCAL_TEST_ACCOUNT_NAME=

# ── E-POSTA (`docs/93`) ───────────────────────────────────────────────────
# Mailgun API taşıyıcısı. SMTP DEĞİL: bir sunucuda 25/587 giden portları
# sıklıkla kapalıdır, HTTPS her yerde açıktır.
#
# ANAHTAR BURAYA YAZILMAZ. Bu dosya depoda; anahtar sunucunun kendi `.env`
# dosyasına ve GitHub secret'ına elle konur.
#
# MAILGUN_ENDPOINT bölgeye göre değişir: `api.mailgun.net` (ABD) ya da
# `api.eu.mailgun.net` (AB). Yanlış uç, "kimlik doğrulanamadı" gibi görünen
# bir bölge hatası verir.
#
# KUM HAVUZU ALANI UYARISI: `sandbox....mailgun.org` yalnız Mailgun panelinde
# YETKİLENDİRİLMİŞ alıcılara teslim eder. Kayıt doğrulama e-postaları rastgele
# bir restoran sahibine ULAŞMAZ; onun için doğrulanmış bir alan adı gerekir.
MAILGUN_DOMAIN=
MAILGUN_SECRET=
MAILGUN_ENDPOINT=api.mailgun.net

# Gelen iletişim mesajının bildirileceği adres. Boşsa e-posta gönderilmez ve
# mesaj yalnız saklanır — bu bir hata değildir.
CONTACT_NOTIFICATION_ADDRESS=

# Destek kanalı (`docs/125`). Yanıt taahhüdü SAAT olarak — boşsa hiçbir
# sayfa, e-posta ya da panel bir yanıt süresi yazmaz; sayı sahibin
# kararıdır. Destek adresi alındı e-postasının "cevapla" adresidir; boşsa
# cevap adresi konmaz.
SUPPORT_RESPONSE_COMMITMENT_HOURS=
SUPPORT_EMAIL=

# --- AI yetenek düzlemi (hepsi non-secret) ---
# Sağlayıcı ANAHTARLARI burada DEĞİL: OpenAI/Gemini anahtarı superadmin
# panelindeki kasaya girilir (`docs/94`), env'e değil. Buradakiler yalnız
# davranış ayarları.
AI_ENABLED=false
# Tenant başına aylık tavan (kuruş). 0 = kapalı (sınırsız DEĞİL).
AI_BUDGET_MONTHLY_MINOR=0
# Model adı koda gömülü değil; sağlayıcı kataloğu değişince buradan güncellenir.
AI_OPENAI_VISION_MODEL=gpt-4o-mini
AI_OPENAI_TIMEOUT=60

# --- Yasal metinler (FF-198, docs/124) — VARSAYILAN YOK, uydurma yok ---
# Boş bırakılan alan yasal sayfalarda "not yet provided" olarak görünür.
LEGAL_COMPANY_LEGAL_NAME=
LEGAL_COMPANY_ADDRESS=
LEGAL_COMPANY_MERSIS=
LEGAL_COMPANY_TAX_OFFICE=
LEGAL_COMPANY_TAX_NUMBER=
LEGAL_COMPANY_EMAIL=
LEGAL_COMPANY_PHONE=
# Hukukçu incelemesinin tarihi (Y-m-d). Doluyken "pending legal review" notu kalkar.
LEGAL_REVIEWED_AT=

# --- Barındırma (FF-228, docs/140 §8) ---
# Verinin fiziksel olarak DURDUĞU yer; veri işleme sözleşmesinin (/data-processing)
# alt işleyen listesindeki ilk satır. Şirket kimliğinin aksine bir VARSAYILANI
# var, çünkü bu ürünün üretim dağıtımı için ölçülmüş bir olgu (netcup GmbH,
# Karlsruhe — docs/42, docs/43). Kendi sunucusuna kuran biri kendi sağlayıcısını
# yazar. Konum ÜLKE ADIYLA yazılmalı: KVKK madde 9 bölümü o satırı okuyor.
#
# DİKKAT: bu iki satır BOŞ bırakılırsa sayfa "not yet provided" der — boş bir
# değer, koddaki varsayılanı da devre dışı bırakır. Bu yüzden örnek dosya
# ölçülmüş değeri TAŞIYOR; kendi sunucusuna kuran biri ikisini de değiştirir.
LEGAL_HOSTING_PROVIDER="netcup GmbH"
LEGAL_HOSTING_LOCATION="Karlsruhe, Germany — outside Turkey"

# --- Hizmet seviyesi (FF-228, docs/140 §4) — VARSAYILAN YOK, uydurma yok ---
# DÖRDÜ BİRLİKTE ya da hiçbiri: biri bile boşken /sla sayfası TEK BİR RAKAM
# göstermez ve neyin taahhüt edilmediğini adıyla sayar. Dördü de sahibin
# ticari kararıdır ve hukuki incelemeden geçmeden yayınlanmamalıdır.
#
# Sıra önemli: ölçüm kaynağı (durum sayfası, docs/107 Faz 3.4) kurulmadan bir
# oran yazmak, müşterinin doğrulayamayacağı bir söz vermektir.
SLA_AVAILABILITY_TARGET_PERCENT=
SLA_MEASUREMENT_SOURCE=
SLA_INCIDENT_NOTIFICATION_MINUTES=
SLA_SERVICE_CREDIT_PERCENT=

# ── ÖLÇÜM (`docs/46`, `docs/126`) ─────────────────────────────────────────
# Uygulamaya YALNIZ Google Tag Manager girer. GA4, Yandex Metrica ve Hotjar
# konteynerin İÇİNDEN yönetilir; kimlikleri koda girmez. Kararın gerekçesi
# `config/analytics.php` başındadır, burada tekrar edilmez.
#
# KONTEYNER KİMLİĞİ BOŞSA ÖLÇÜM TAMAMEN KAPALIDIR: tek bir script yüklenmez
# ve CSP bugünkü kadar sıkı kalır. Yerel geliştirme ve testler bu durumdadır
# ve öyle kalmalıdır — testler ağ üzerinden bir ölçüm aracına bağlanmaz.
#
# Bu dosya depoda; gerçek `GTM-XXXXXXX` kimliği buraya YAZILMAZ, yalnız
# ortamın kendi `.env` dosyasına konur (`docs/126`).
ANALYTICS_GTM_CONTAINER_ID=

# Aşağıdakiler GTM'i yapılandırmaz — CSP'yi yapılandırır. Bir hedefi burada
# açmadan GTM arayüzünde etiketini kurmak İŞE YARAMAZ: tarayıcı isteği
# engeller, hata da vermez, veri de akmaz.
ANALYTICS_GA4_ENABLED=false
ANALYTICS_YANDEX_METRICA_ENABLED=false
ANALYTICS_HOTJAR_ENABLED=false

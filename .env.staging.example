APP_NAME=Zabuno
APP_ENV=staging
APP_KEY=
APP_DEBUG=false
APP_URL=https://staging.example.invalid

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# Shared-host default: DB-backed cache/queue/session (docs/03 ADR-L08). The
# concrete adapter (mysql/pgsql) is a per-provider deployment choice — these
# are example values only, no host/credential is real.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=zabuno_staging
DB_USERNAME=zabuno_staging
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
# Oturum çerezi yalnız HTTPS üzerinden gider. Kapalı olsaydı, aynı ağdaki
# biri ilk HTTP isteğinde çerezi düz metin görebilirdi.
SESSION_SECURE_COOKIE=true
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

# Redis/S3 are opt-in adapters, never the default (docs/03 ADR-L08) — left
# commented so an unconfigured staging host does not silently depend on them.
# REDIS_CLIENT=phpredis
# REDIS_HOST=127.0.0.1
# REDIS_PASSWORD=
# REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="staging@example.invalid"
MAIL_FROM_NAME="${APP_NAME}"

# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=us-east-1
# AWS_BUCKET=
# AWS_USE_PATH_STYLE_ENDPOINT=false

# Iyzico Checkout Form sandbox — never a live key on staging (docs/09 §5-6).
IYZICO_SANDBOX_API_KEY=
IYZICO_SANDBOX_SECRET_KEY=
IYZICO_SANDBOX_BASE_URL=https://sandbox-api.iyzipay.com
IYZICO_SANDBOX_PROFILE_BUYER_ID=
IYZICO_SANDBOX_PROFILE_BUYER_NAME=
IYZICO_SANDBOX_PROFILE_BUYER_SURNAME=
IYZICO_SANDBOX_PROFILE_BUYER_EMAIL=
IYZICO_SANDBOX_PROFILE_BUYER_IDENTITY_NUMBER=
IYZICO_SANDBOX_PROFILE_BUYER_REGISTRATION_ADDRESS=
IYZICO_SANDBOX_PROFILE_BUYER_CITY=
IYZICO_SANDBOX_PROFILE_BUYER_COUNTRY=
IYZICO_SANDBOX_PROFILE_BUYER_ZIP_CODE=
IYZICO_SANDBOX_PROFILE_BUYER_IP=
IYZICO_SANDBOX_PROFILE_BILLING_CONTACT_NAME=
IYZICO_SANDBOX_PROFILE_BILLING_CITY=
IYZICO_SANDBOX_PROFILE_BILLING_COUNTRY=
IYZICO_SANDBOX_PROFILE_BILLING_ADDRESS=
IYZICO_SANDBOX_PROFILE_BILLING_ZIP_CODE=
IYZICO_SANDBOX_PROFILE_SHIPPING_CONTACT_NAME=
IYZICO_SANDBOX_PROFILE_SHIPPING_CITY=
IYZICO_SANDBOX_PROFILE_SHIPPING_COUNTRY=
IYZICO_SANDBOX_PROFILE_SHIPPING_ADDRESS=
IYZICO_SANDBOX_PROFILE_SHIPPING_ZIP_CODE=

VITE_APP_NAME="${APP_NAME}"

# Bu dosya, bu deponun kendisinin — public `zabuno/zabuno` kökünün —
# `.gitignore`'ıdır (docs/31-PUBLIC-REPOSITORY-GOVERNANCE.md §5). Ham kanıt/
# snapshot dosyaları burada silinmez, yalnız public depodan dışlanır.

# Yalnız yerel workspace/Git sınır sözleşmesi (mutlak yol taşır) — asla
# tracked/public olmaz; bkz. AGENTS.md §Workspace/repo preflight
/.local/

# Ham kanıt — yalnız public archive attestation istisna
/evidence/*
!/evidence/PUBLIC-ARCHIVE-ATTESTATION.md

# Arşivlenmiş eski proje kökü (varsa) ve Git worktree çalışma kopyaları —
# public depoya hiçbir koşulda dahil edilmez (docs/31 §2); `worktrees/`
# burada standart `git worktree` mekanizmasının çalışma dizinlerini ifade
# eder, ayrı bir arşiv değildir.
/old/
/worktrees/

# Lisanssız upstream snapshot byte'ları (docs/16 LIC-01, docs/28 §1)
/research/upstream/imageoptimization/snapshot/

# Secret / env
.env
.env.*
!.env.example
*.pem
*.key

# Bağımlılıklar / derlenmiş çıktı
/vendor/
/node_modules/
/public/build/
/storage/*.key

# Cache / log
*.log
.phpunit.cache/

# IDE / OS
.idea/
.vscode/
.DS_Store

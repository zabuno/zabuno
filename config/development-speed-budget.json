{
  "$schemaNote": "Single canonical numeric speed-policy source for SP-01 (fast-delivery genome). Consumed by scripts/speed-gate. AGENTS.md, .claude/rules/fast-development.md, .claude/skills/zabuno-speeder/SKILL.md, .claude/agents/zabuno-speeder.md, docs/26, docs/27 and both speeder reports must reference this file by path and must not restate its numbers.",
  "checkpointCadenceMinutesMax": 20,
  "checkpointCadenceAppliesTo": ["prototype", "microHotfix", "normal", "highRisk"],
  "lanes": {
    "prototype": {
      "targetedTestMax": 0,
      "testFilesMax": 0,
      "browserRunsMax": 0,
      "fullLocalQaMax": 0,
      "ciFullQaMax": 0,
      "reviewerFullSuiteRunsMax": 0
    },
    "microHotfix": {
      "targetedTestMin": 1,
      "targetedTestMax": 3,
      "testFilesMax": 1,
      "browserRunsMax": 0,
      "fullLocalQaMax": 1,
      "ciFullQaMax": 1,
      "productDiffLinesMax": 30,
      "adjacentMicroFixesMax": 3,
      "reviewerFullSuiteRunsMax": 0
    },
    "normal": {
      "targetedTestMin": 3,
      "targetedTestMax": 8,
      "testFilesMax": 2,
      "browserRunsMax": 1,
      "fullLocalQaMax": 1,
      "ciFullQaMax": 1,
      "reviewerFullSuiteRunsMax": 0,
      "reviewerCanAuthorTests": false,

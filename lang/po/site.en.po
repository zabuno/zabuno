msgid "site.plan.analytics"
msgstr "Analytics: what guests look at, and what they search for and cannot find"

#: site:site.plan.audience.restaurant
msgid "site.plan.audience.restaurant"
msgstr "You run a room of tables yourself, and you want the page the guest reads to look like your restaurant rather than like a form."

#: site:site.plan.audience.starter
msgid "site.plan.audience.starter"
msgstr "You are putting your menu behind a QR code for the first time, you look after it yourself, and you would rather not pay to find out whether it works."

#: site:site.plan.audience.team
msgid "site.plan.audience.team"
msgstr "You are not the only one who touches the menu: a manager, a waiter or an accountant needs an account of their own instead of yours."

#: site:site.plan.branding
msgid "site.plan.branding"
msgstr "Your own colours and type on the guest menu"

#: site:site.plan.ordering
msgid "site.plan.ordering"
msgstr "Guests order from the table; your staff confirms and the kitchen sees it"

#: site:site.plan.qrBulk
msgid "site.plan.qrBulk"
msgstr "Bulk QR codes for a whole room of tables"

#: site:site.plan.richMedia
msgid "site.plan.richMedia"
msgstr "Photographs of your dishes on the guest menu"

#: site:site.plan.team
msgid "site.plan.team"

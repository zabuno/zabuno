#!/usr/bin/env bash
# adaptive-bundle-gate — cihaza özgü kodun GERÇEKTEN ayrı paketlendiğini kanıtlar.
#
#   adaptive-bundle-gate [--root resources/js]
#
# Verdicts: PASS | LEAK | NO_ENTRY
#
# NEDEN VAR (docs/54, docs/60):
#
# Adaptive yükleme "kodu göstermemek" değil, "kodu İNDİRMEMEK"tir. Bu ayrım
# okuyarak doğrulanamaz: masaüstüne özgü bir bileşen, paylaşılan bir dosyadaki
# tek bir `import` satırıyla telefon paketine sızabilir ve ekranda hiç
# görünmediği için kimse fark etmez. FF-03a'da tam bu oldu — bağlam paneli
# `MenuPage.section.tsx` üzerinden mobil pakete de girmişti ve "mobil pakette
# bulunmaz" cümlesi yazıldığı anda yanlıştı.
#
# NEDEN MANIFEST DEĞİL: Vite manifest'i YIĞIN düzeyindedir, modül düzeyinde
# değil. Bir yığının hangi kaynak dosyalardan oluştuğunu söylemez, dolayısıyla
# "şu dosya mobil pakete girdi mi" sorusunu cevaplayamaz.
#
# NEDEN GLOB ÖNEMLİ: ilk sızıntı düz bir `import` satırından değil,
# `import.meta.glob('../pages/*.section.tsx')` üzerinden geldi. Glob'u
# genişletmeyen bir gezgin, yakalamak için yazıldığı sızıntıyı kaçırırdı.
#
# STİL DE BİR PAKETTİR (`docs/151`): masaüstünün kendi stil katmanı
# (`resources/css/app-desktop.css`) yalnız masaüstü belgesinden istenir.
# JavaScript için yazılan cümlenin aynısı burada da geçerli — `app.css`
# içine bir `@import` satırı, o katmanı telefona da indirirdi ve hiç
# çizilmediği için kimse fark etmezdi. Kapı bu yüzden CSS zincirini de
# yürür.
set -u

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
ROOT="$REPO_ROOT/resources/js"

while [ $# -gt 0 ]; do
  case "$1" in
    --root) ROOT="$2"; shift 2 ;;
    *) printf 'adaptive-bundle-gate: unknown argument %s\n' "$1" >&2; exit 2 ;;
  esac
done

ADAPTIVE_ROOT="$ROOT" python3 - <<'PY'
import os, re, sys
from pathlib import Path

ROOT = Path(os.environ['ADAPTIVE_ROOT']).resolve()

DESKTOP_ENTRY = ROOT / 'workspace.desktop.tsx'
MOBILE_ENTRY = ROOT / 'workspace.mobile.tsx'

# Cihaza özgü olduğu BİLDİRİLEN modüller — tek tek dosya değil ÖRÜNTÜ.
#
# Dosya listesi tutmayı ilk denemede yaptım ve kapı sızıntıyı KAÇIRDI: liste
# panel HARİTASINI adlandırıyordu, oysa mobil pakete sızan şey panel
# BİLEŞENİYDİ. Örüntü, yarın eklenecek ikinci panelin listeye yazılmasını
# unutma ihtimalini ortadan kaldırır.
DESKTOP_ONLY = [
    'components/workspace/chrome/DesktopChrome.tsx',
    'components/workspace/inspectors/*.tsx',
    'components/workspace/pages/**/*Inspector.tsx',
    # MUTFAK MONİTÖRÜ (FF-179, docs/115 S5).
    #
    # Duvara asılan bir ekran için yazıldı: uzaktan okunur tipografi, 56
    # piksellik hedefler, tam ekran kipi. Telefonun bu koddan indirebileceği
    # hiçbir şey yok — 320 pikselde çizilemez ve orada zaten çizilmiyor.
    #
    # KLASÖR ÖRÜNTÜSÜ, dosya listesi DEĞİL: monitör yarın ikinci bir parçaya
    # bölünürse (fiş bileşeni, tam ekran düğmesi) o parça listeye yazılmayı
    # beklemeden kapının kapsamına girer.
    'components/workspace/kitchen/*.tsx',
    # MASAÜSTÜNÜN KENDİ DİZELERİ (`docs/151`, `docs/153` §9 M1).
    #
    # `docs/153` §8 borcu adıyla yazmıştı: kataloglar cihaz TANIMIYORDU ve
    # yalnız masaüstünde çizilen on bir dize telefonun paketine de iniyordu.
    # Ayrı bir glob'la toplanan bu klasör o borcu kapatır; kapı da onu
    # bileşenlerle aynı sertlikte tutar, çünkü bir dize tablosu da bayttır.
    'i18n/workspace-desktop.ts',
    'i18n/workspace-desktop/*.ts',
]
MOBILE_ONLY = [
    'components/workspace/chrome/MobileChrome.tsx',
]

# CİHAZ KLASÖRLERİ — dosya değil, KURAL (`docs/153` §8).
#
# Yukarıdaki listeler tek tek modülleri adlandırır ve bir modül eklemeyi
# unutmak sessizce mümkündür. Bu iki klasör o boşluğu kapatır: altına konan
# HER dosya, listeye yazılmayı beklemeden kendi paketine kilitlenir.
#
# Kural bu yüzden bir konvansiyondur ve belgelenmiştir: masaüstüne özgü bir
# bileşen `pages/desktop/` altına, dokunmaya özgü olan `pages/mobile/`
# altına yazılır. Yanlış klasöre yazılan dosya, ötekinin paketinden
# ulaşılabilir hâle geldiği ANDA kapıyı kırar — kimsenin bir listeyi
# güncellemesi gerekmeden.
#
# BOŞ OLMASI HATA DEĞİL: `pages/mobile/` bugün boştur, çünkü 320 tabanı
# PAYLAŞILAN koddur (TOUCH-FIRST-INTERFACE §1) ve dokunma sürümü ortak
# dosyalarda yaşar. Klasör, dokunmaya ÖZGÜ bir bileşen ilk yazıldığında
# dolacak ve kural o gün de hazır olacak. Boş bir klasörü "bayat bildirim"
# sayan bir kapı, konvansiyonun kurulmasını imkânsız kılardı.
DESKTOP_ONLY_DIRS = ['components/workspace/pages/desktop']
MOBILE_ONLY_DIRS = ['components/workspace/pages/mobile']


SPEC_RE = re.compile(
    r"""(?:\bfrom\s*|\bimport\s*\(\s*|\bimport\s+)['"]([^'"]+)['"]"""
)
# TÜR ARGÜMANI GLOB'U GÖRÜNMEZ YAPIYORDU (`docs/151`).
#
# Kapı `import.meta.glob(` diye arıyordu; oysa i18n toplayıcıları çağrıyı
# `import.meta.glob<{ ... }>(` biçiminde yazıyor. Yani KATALOG GLOB'LARININ
# HİÇBİRİ gezilmiyordu ve kapı bunu söylemiyordu — bir dize tablosunun
# sızması, tam da yakalamak için yazıldığı yoldan geçip görünmez kalırdı.
# Tür argümanı derlemede silinir ama ÇAĞRI kalır: örüntü onu atlar, glob'u
# değil.
GLOB_RE = re.compile(
    r"""import\.meta\.glob\s*(?:<[^()]*>)?\s*\(\s*['"]([^'"]+)['"]"""
)

# `import type` ve `export type` derlemede TAMAMEN silinir: hiçbir baytı pakete
# girmez. Bunları saymak, olmayan bir sızıntıyı bildirmek olurdu. Ama satır
# başındaki `type` kelimesi düşerse import gerçek olur — kapı o günü yakalar,
# çünkü silme yalnız `import type` ile BAŞLAYAN ifadeye uygulanır.
TYPE_ONLY_RE = re.compile(r'^\s*(?:import|export)\s+type\s[^;]*?;', re.M)

EXTS = ('.tsx', '.ts', '.jsx', '.js')


def resolve(spec: str, importer: Path):
    """Göreli bir specifier'ı dosyaya çözer; paket adlarını yok sayar."""
    if not spec.startswith('.'):
        return None  # node_modules — cihaz ayrımının konusu değil
    base = (importer.parent / spec).resolve()
    if base.is_file():
        return base
    for ext in EXTS:
        cand = base.with_suffix(base.suffix + ext) if base.suffix else Path(str(base) + ext)
        if cand.is_file():
            return cand
    for ext in EXTS:
        cand = Path(str(base) + ext)
        if cand.is_file():
            return cand
    for ext in EXTS:
        cand = base / ('index' + ext)
        if cand.is_file():
            return cand
    return None


def closure(entry: Path):
    """Girişten ulaşılan tüm kaynak dosyalar: statik, dinamik ve glob."""
    seen, stack = set(), [entry]
    while stack:
        path = stack.pop()
        if path in seen or not path.is_file():
            continue
        seen.add(path)
        try:
            source = path.read_text(encoding='utf-8')
        except (UnicodeDecodeError, OSError):
            continue

        source = TYPE_ONLY_RE.sub('', source)

        # `import.meta.glob` eşleşen HER dosyayı pakete alır.
        for pattern in GLOB_RE.findall(source):
            if pattern.startswith('.'):
                for match in sorted(path.parent.glob(pattern)):
                    if match.is_file():
                        stack.append(match.resolve())

        for spec in SPEC_RE.findall(source):
            target = resolve(spec, path)
            if target is not None:
                stack.append(target)
    return seen


for entry in (DESKTOP_ENTRY, MOBILE_ENTRY):
    if not entry.is_file():
        print(f'adaptive-bundle-gate: entry {entry} not found', file=sys.stderr)
        print('NO_ENTRY')
        sys.exit(1)

desktop_reach = closure(DESKTOP_ENTRY)
mobile_reach = closure(MOBILE_ENTRY)

leaks = []


def expand(pattern):
    """Örüntüyü dosyalara açar; hiç eşleşmemesi SESSİZ GEÇİŞ değil, hatadır."""
    if any(ch in pattern for ch in '*?['):
        matches = sorted(
            path.resolve()
            for path in ROOT.glob(pattern)
            if path.is_file()
            and not path.name.endswith(('.test.ts', '.test.tsx', '.stories.tsx'))
        )
        if not matches:
            leaks.append(f'{pattern} matches no file (stale declaration)')
        return matches
    target = (ROOT / pattern).resolve()
    if not target.is_file():
        leaks.append(f'{pattern} is declared device-specific but does not exist')
        return []
    return [target]


def check(patterns, own, other, own_name, other_name):
    for pattern in patterns:
        for target in expand(pattern):
            rel = target.relative_to(ROOT)
            if target in other:
                leaks.append(f'{rel} is reachable from the {other_name} entry')
            if target not in own:
                leaks.append(f'{rel} is NOT reachable from the {own_name} entry (dead or misnamed)')


def expand_dir(rel_dir):
    """Klasördeki her kaynak dosya. Klasörün BOŞ ya da yok olması hata değil."""
    base = (ROOT / rel_dir)
    if not base.is_dir():
        return []
    return sorted(
        path.resolve()
        for path in base.rglob('*')
        if path.is_file()
        and path.suffix in ('.ts', '.tsx')
        and not path.name.endswith(('.test.ts', '.test.tsx', '.stories.tsx'))
    )


def check_dirs(dirs, own, other, own_name, other_name):
    for rel_dir in dirs:
        for target in expand_dir(rel_dir):
            rel = target.relative_to(ROOT)
            if target in other:
                leaks.append(f'{rel} is reachable from the {other_name} entry')
            if target not in own:
                leaks.append(f'{rel} is NOT reachable from the {own_name} entry (dead or misnamed)')


check(DESKTOP_ONLY, desktop_reach, mobile_reach, 'desktop', 'MOBILE')
check(MOBILE_ONLY, mobile_reach, desktop_reach, 'mobile', 'DESKTOP')
check_dirs(DESKTOP_ONLY_DIRS, desktop_reach, mobile_reach, 'desktop', 'MOBILE')
check_dirs(MOBILE_ONLY_DIRS, mobile_reach, desktop_reach, 'mobile', 'DESKTOP')

if leaks:
    for leak in leaks:
        print(f'adaptive-bundle-gate: {leak}', file=sys.stderr)
    print('LEAK')
    sys.exit(1)

desktop_count = sum(len(expand(p)) for p in DESKTOP_ONLY) + sum(
    len(expand_dir(d)) for d in DESKTOP_ONLY_DIRS
)
mobile_count = sum(len(expand(p)) for p in MOBILE_ONLY) + sum(
    len(expand_dir(d)) for d in MOBILE_ONLY_DIRS
)


def weigh(paths):
    return sum(path.stat().st_size for path in paths)


# İKİ PAKETİN AĞIRLIĞI AYRI AYRI (`docs/153` §8).
#
# KAYNAK baytıdır, derlenmiş paket değil: kapı derleme İSTEMEDEN koşsun diye.
# Derlenmiş ağırlık ayrıca ölçülür ve ikisi farklı sorulara cevap verir —
# buradaki sayı "bu cihaz kaç satır kodu görüyor", ötekisi "kaç bayt iniyor".
desktop_bytes = weigh(desktop_reach)
mobile_bytes = weigh(mobile_reach)
shared = desktop_reach & mobile_reach
print(f'adaptive-bundle-gate: {desktop_count} desktop-only and '
      f'{mobile_count} mobile-only modules stay in their own bundle',
      file=sys.stderr)
print(f'adaptive-bundle-gate: desktop closure {len(desktop_reach)} files '
      f'({desktop_bytes:,} B source), mobile {len(mobile_reach)} files '
      f'({mobile_bytes:,} B source), shared {len(shared)} files '
      f'({weigh(shared):,} B)',
      file=sys.stderr)

# ══════════════════════════════════════════════════════════════════════
# STİL KATMANI — `docs/151`
#
# Bileşen kapısının stil karşılığı. Üç şey ölçülür ve üçü de ayrı bir
# arıza ailesidir:
#
# 1. SIZINTI — paylaşılan giriş (`app.css`) masaüstü katmanını `@import`
#    ediyorsa, katman telefona da iner. Bileşen tarafında bunun karşılığı
#    "paylaşılan dosya cihaza özgü modülü adıyla anıyor"du.
# 2. ÖLÜ KOD — katman kendi girişinden ulaşılamıyorsa (Vite girdi listesine
#    yazılmamışsa) hiç yüklenmiyor demektir; yeşil bir kapı, çizilmeyen bir
#    stili "ayrılmış" diye rapor ederdi.
# 3. GENİŞLİKLE CİHAZ SEÇİMİ — katmanın içinde `min-width`/`max-width` ile
#    yapılan bir cihaz kararı, `docs/54`'ün reddettiği şeyin CSS'e taşınmış
#    hâlidir. `hover`/`pointer`/`prefers-*` özellik sorguları SERBEST: onlar
#    genişlik değil GİRİŞ KİPİ sorgular ve ayrımın kendisidir.
# ══════════════════════════════════════════════════════════════════════

CSS_ROOT = ROOT.parent / 'css'
SHARED_CSS_ENTRY = CSS_ROOT / 'app.css'
DESKTOP_CSS_ENTRY = CSS_ROOT / 'app-desktop.css'
VITE_CONFIG = ROOT.parent.parent / 'vite.config.ts'

CSS_IMPORT_RE = re.compile(r"""@import\s+(?:url\()?['"]([^'"]+)['"]""")
# `@media` başlığındaki genişlik ölçütü. `@container` KAPSAM DIŞI: o ekranı
# değil kapsayıcıyı sorar ve bir cihaz seçimi değildir.
MEDIA_WIDTH_RE = re.compile(r'@media[^{]*\b(?:min|max)-width\b')
# YORUMLAR ÖNCE SİLİNİR. Bu dosyaların yorumları kuralın KENDİSİNİ anlatıyor
# ("`max-width` ile bastırma yok") ve ham metinde arayan bir kapı, yasağı
# açıklayan cümleyi ihlal sanardı — ilk koşuda tam bu oldu.
CSS_COMMENT_RE = re.compile(r'/\*.*?\*/', re.S)


def css_closure(entry):
    """Bir CSS girişinden `@import` ile ulaşılan tüm yerel dosyalar."""
    seen, stack = set(), [entry]
    while stack:
        path = stack.pop()
        if path in seen or not path.is_file():
            continue
        seen.add(path)
        try:
            source = path.read_text(encoding='utf-8')
        except (UnicodeDecodeError, OSError):
            continue
        for spec in CSS_IMPORT_RE.findall(source):
            if not spec.startswith('.'):
                continue  # paket adı (tailwindcss, flowbite) — cihazın konusu değil
            target = (path.parent / spec).resolve()
            if target.is_file():
                stack.append(target)
    return seen


css_leaks = []

if not DESKTOP_CSS_ENTRY.is_file():
    css_leaks.append('resources/css/app-desktop.css is missing (the desktop style layer is declared but absent)')
else:
    shared_css = css_closure(SHARED_CSS_ENTRY)

    if DESKTOP_CSS_ENTRY.resolve() in shared_css:
        css_leaks.append(
            'app-desktop.css is reachable from the SHARED css entry (app.css) — '
            'the phone would download it'
        )

    desktop_css = css_closure(DESKTOP_CSS_ENTRY)

    if SHARED_CSS_ENTRY.resolve() in desktop_css:
        css_leaks.append(
            'app-desktop.css imports the shared entry app.css — every shared byte '
            'would be served twice'
        )

    # ÖLÜ KOD: katman Vite girdi listesinde yoksa hiç derlenmez.
    if VITE_CONFIG.is_file():
        vite_source = VITE_CONFIG.read_text(encoding='utf-8')
        if 'resources/css/app-desktop.css' not in vite_source:
            css_leaks.append(
                'app-desktop.css is not a Vite input (dead: it would never be built)'
            )

    for path in sorted(desktop_css):
        source = CSS_COMMENT_RE.sub('', path.read_text(encoding='utf-8'))
        for match in MEDIA_WIDTH_RE.findall(source):
            css_leaks.append(
                f'{path.name} selects by WIDTH in a media query — the device '
                'decision belongs to the server (use hover/pointer feature queries)'
            )

if css_leaks:
    for leak in css_leaks:
        print(f'adaptive-bundle-gate: {leak}', file=sys.stderr)
    print('LEAK')
    sys.exit(1)

shared_css_bytes = weigh(css_closure(SHARED_CSS_ENTRY))
desktop_css_bytes = weigh(css_closure(DESKTOP_CSS_ENTRY))
print(f'adaptive-bundle-gate: shared css {shared_css_bytes:,} B source, '
      f'desktop-only css {desktop_css_bytes:,} B source '
      f'(mobile documents request 0 B of it)',
      file=sys.stderr)
print('PASS')
PY

#!/usr/bin/env node
/*
    MOBİL DENETİM — her bileşen, en dar ekranda, gerçek bir düzen motorunda.

    ═══ NEDEN VAR ═══

    Global kural (`TOUCH-FIRST-INTERFACE`) dar ekranı TABAN sayar ve
    doğrulamanın gerçek bir düzen motorunda yapılmasını şart koşar. Bu
    deponun bütün arayüz testleri jsdom'da koşuyor ve jsdom düzen
    HESAPLAMAZ: her kutu sıfır yüksekliktedir, hiçbir şey taşmaz, hiçbir
    dokunma hedefi ölçülemez. Yani "320 pikselde çalışıyor mu" sorusu bu
    depoda hiç sorulamıyordu — ve sorulmadığı için cevabı yıllarca "bilmiyoruz"
    kaldı, ama raporlarda "geçti" diye göründü.

    ═══ NE ÖLÇÜYOR ═══

    Storybook'un statik çıktısındaki HER hikâye, 320×568'de:

    1. YATAY TAŞMA — sayfa yana kaymamalı. Dar ekranda yatay kaydırma,
       kullanıcının bir daha bulamayacağı içerik demektir.
    2. KENARDAN KIRPILMA — hiçbir etkileşimli öğe görünen alanın dışına
       taşmamalı. Görünmeyen bir düğme, olmayan bir düğmedir.
    3. DOKUNMA HEDEFİ — en az 44×44. Parmak imleç değildir.
    4. HEDEFLER ARASI AYRIM — komşu iki hedef arasında en az 8 piksel.
       Bitişik iki hedef, yanlış dokunmayı bir hata değil bir olasılık yapar.
    5. METİN KIRPILMASI — taşan metin ya sığdırılır ya üç noktayla kesilir;
       sessizce kesilen metin okunamaz ve okunamadığı ANLAŞILMAZ.
    6. İÇERİK YOĞUNLUĞU — en içteki içerik sütunu, görüntü alanının anlamlı
       bir oranını kullanmalı. İç içe kapların dolgusu birikirse içerik dar
       bir şeride sıkışır: ekranın yarısı kenar boşluğu olur.

    ═══ NEYİ ÖLÇMÜYOR ═══

    Estetik, hiyerarşi, kelime seçimi ve akış. Bunlar insan kararıdır ve bu
    araç onları ölçtüğünü iddia etmiyor. Ölçtüğü şey, o kararların
    tartışılabilmesi için gereken zemin: ekranda gerçekten ne oluyor.

    Ayrıca Chrome'da koşuyor; iOS Safari'nin kendi davranışını doğrulamıyor.

    ═══ KULLANIM ═══

        # Storybook hikâyeleri (React yüzeyi)
        npm run build-storybook -- -o <dizin>
        node scripts/mobile-ux-audit <dizin> [--json rapor.json] [--fail]

        # Sunucuda üretilen sayfalar (kurumsal site kabuğu)
        php artisan site:export-static --out=<dizin>
        node scripts/mobile-ux-audit <dizin> [--json rapor.json] [--fail]

    İkinci kip, dizinde `index.json` OLMAMASINDAN anlaşılır. Kurumsal sitenin
    kabuğu bir React hikâyesi değil, Blade'dir; onu ölçmek için elle bir
    hikâye yazmak, ölçtüğünü sandığı şeyden sessizce ayrışan bir düzenek
    kurmak olurdu (`docs/117` §4.2).

    `--fail` olmadan RAPORLAR ama kırılmaz: mevcut borç bir kapıya
    dönüştürülmeden önce görülmeli. Borç kapandıkça `--fail` ile CI'ya
    bağlanır.

    ═══ YÖN — `--direction rtl` ═══

    Dokuz dilin ikisi sağdan sola yazılır (`ar`, `fa`). `docs/121` §4'ün
    açıkça söylediği gibi SAHTE-YERELLEŞTİRME BUNU ÖLÇMEZ: aksanlı harf ve
    dolgu, uzayan metnin kırdığı düzeni gösterir, ters akan bir düzenin
    kırdığını değil. Onu ölçen tek şey, sayfayı gerçekten sağdan sola
    açmaktır (`docs/120` §7).

        node scripts/mobile-ux-audit <dizin> --direction rtl \
             --baseline scripts/mobile-ux-audit.rtl.baseline.json

    Hikâye kipinde yön, Storybook'un KENDİ global'i üzerinden çevrilir
    (`?globals=direction:rtl`) — yani ürünün gerçekten kullandığı
    `withDirection` decorator'ünden geçer. DOM'a elle `dir` yazmak, ölçümü
    ürünün yolundan koparır ve bir gün decorator değiştiğinde ölçüm sessizce
    başka bir şeyi ölçer. Sayfa kipinde `<html dir>` çevrilir, çünkü orada
    yönü yazan taraf zaten sunucudur (`DocumentLocale::direction()`).

    ÇEVİRİ DEĞİLDİR. Tek kelime çevrilmez; yalnız yön çevrilir. Ölçülen şey
    dilin kendisi değil, düzenin ters yönde ayakta kalıp kalmadığıdır.
*/

import { spawn } from 'node:child_process';
import { existsSync, mkdtempSync, readdirSync, readFileSync, rmSync, writeFileSync } from 'node:fs';
import { tmpdir } from 'node:os';
import { join, resolve } from 'node:path';

const CHROME_CANDIDATES = [
    process.env.CHROME_PATH,
    '/Applications/Google Chrome.app/Contents/MacOS/Google Chrome',
    '/usr/bin/google-chrome',
    '/usr/bin/google-chrome-stable',
    '/usr/bin/chromium',
    '/usr/bin/chromium-browser',
].filter(Boolean);

const CHROME = CHROME_CANDIDATES.find((candidate) => existsSync(candidate));

if (CHROME === undefined) {
    console.error('mobile-ux-audit: Chrome bulunamadı — ölçüm YAPILMADI, sonuç "bilinmiyor".');
    process.exit(2);
}

/*
    SABİT PORT YOK — Chrome portu kendisi seçer, araç onu diskten okur.

    Sabit bir port (9355), aynı makinede eşzamanlı çalışan İKİNCİ bir
    denetimin (başka bir çalışma ağacı, başka bir işçi) Chrome'una
    bağlanmayı mümkün kılardı: iki araç aynı sayfayı yönlendirir, biri
    diğerinin hikâyesini ölçer. Bu bir olasılıktı, yaşanmış bir kusur
    değil; portu Chrome'a bırakmak o olasılığı sıfırlar.
*/

/*
    ÖLÇÜLEN GENİŞLİK — varsayılan 320, TABAN budur.

    `--width` bayrağı 2026-09-08'de eklendi ve sırayı DEĞİŞTİRMEZ: dar ekran
    hâlâ tabandır, geniş ekran hâlâ zenginleştirmedir, CI kapısı hâlâ 320'de
    koşar (`.github/workflows/ci.yml`). Bayrak yalnız ikinci bir SORUYU
    sorulabilir kılar: "aynı düzen geniş ekranda da ayakta mı?"

    Sorunun gerekçesi ölçülmüş bir riskti: kırılma noktası kullanmayan akışkan
    bir ızgara (`repeat(auto-fit, minmax(…))`) 320'de doğru olup 1280'de
    dağılabilir — sütunlar gereğinden çok, hedefler gereğinden dar. 320'de
    ölçüp geniş ekranı hiç açmamak, o dağılmayı sahibin ekranında keşfetmek
    demekti.

    Yükseklik genişlikle birlikte gelir: 320×568 bir telefon, 1280×800 bir
    dizüstü. Yükseklik ayrı bir bayrak DEĞİL, çünkü ikisini bağımsız
    seçmek "ölçtüğüm cihaz hangisi" sorusunu cevapsız bırakırdı.
*/
const widthFlag = process.argv.indexOf('--width');
const WIDTH = widthFlag > -1 ? Number.parseInt(process.argv[widthFlag + 1] ?? '', 10) : 320;

if (!Number.isInteger(WIDTH) || WIDTH < 320 || WIDTH > 3840) {
    console.error(
        `mobile-ux-audit: --width 320 ile 3840 arasında bir tam sayı olmalı (gelen: ${process.argv[widthFlag + 1]}).`,
    );
    process.exit(2);
}

/*
    GİRİŞ KİPİ GENİŞLİKTEN TÜREMEZ AMA CİHAZ TÜRER (`docs/118` E2).

    768'in altı bir telefon olarak emüle edilir (dokunma, `mobile: true`);
    üstü bir işaretleyici cihazıdır. Bu, "medya sorgusuyla iki düzen" demek
    DEĞİL — ölçülen ŞEYİN ne olduğunu söylemek: aynı tek düzen, iki farklı
    giriş kipinde.
*/
const MOBILE = WIDTH < 768;
const HEIGHT = MOBILE ? 568 : 800;

/** Dokunma hedefinin asgarisi (CSS pikseli). */
const MIN_TARGET = 44;

/** Komşu iki hedef arasındaki asgari ayrım. */
const MIN_GAP = 8;

/**
 * İçerik sütununun görüntü alanına asgari oranı.
 *
 * 0.72 bir hedef değil, bugünkü borcu görünür kılan bir sınır: altına düşen
 * her ekranda, genişliğin dörtte birinden fazlası iç içe kapların dolgusuna
 * gidiyor demektir.
 */
const MIN_CONTENT_RATIO = 0.72;

const MEASURE = `(() => {
  const W = ${WIDTH}, MIN_TARGET = ${MIN_TARGET}, MIN_GAP = ${MIN_GAP};
  const root = document.getElementById('storybook-root') || document.body;

  /*
      STORYBOOK'UN KENDİ DOLGUSU ÖLÇÜME KARIŞMAZ.

      Storybook gövdeye kendi kenar boşluğunu koyuyor. Onu ürünün dolgusu
      saymak, olmayan bir borcu raporlamak olurdu — ve bu araç tam da o hatayı
      yakalamak için var.
  */
  document.body.style.margin = '0';
  document.body.style.padding = '0';
  const main = document.querySelector('.sb-show-main');
  if (main) { main.style.margin = '0'; main.style.padding = '0'; }
  root.style.margin = '0';
  root.style.padding = '0';

  /* Animasyonlar ölçümden ÖNCE ayrı bir adımda dondurulur (FREEZE, aşağıda):
     hareket eden bir öğenin tek bir genişliği yoktur. */

  /*
      YATAY KAYAN BİR KAP TAŞMA DEĞİLDİR.

      Kategori rayı gibi bilerek yana kayan şeritlerde öğelerin görünen alanın
      dışına uzanması TASARIMIN kendisidir. Onları kırpılmış saymak, çalışan
      bir deseni kusur diye bildirmek olurdu.
  */
  const inHorizontalScroller = (el) => {
    for (let node = el.parentElement; node && node !== document.body; node = node.parentElement) {
      const s = getComputedStyle(node);
      if ((s.overflowX === 'auto' || s.overflowX === 'scroll') && node.scrollWidth > node.clientWidth + 1) {
        return true;
      }
    }
    return false;
  };
  const label = (el) => {
    const text = (el.getAttribute('aria-label') || el.textContent || '').trim().replace(/\\s+/g, ' ');
    return (el.tagName.toLowerCase() + (text ? ' "' + text.slice(0, 40) + '"' : ''));
  };

  /*
      KAPALI <details> İÇİNDEKİ KUTULAR HAYALETTİR.

      Chrome kapalı bir <details>'in içeriğini artık \`display:none\` ile
      değil \`content-visibility:hidden\` ile gizliyor: kutular akışta yer
      kaplamaz, ekranda çizilmez, ama getBoundingClientRect() bir
      dikdörtgen döndürür — bölümün durduğu yerde, altındaki GERÇEK
      içeriğin üstüne düşen bir dikdörtgen. Profil ekranının kapalı parola
      bölümündeki girdiler, tam altındaki görünüm seçeneklerinin gizli
      radyo düğmelerine "0 piksel" mesafede ölçüldü ve \`docs/117\` K3
      ("iki parola girdisi 0 px") bu hayalete yazıldı. 2026-09-06'da
      anlaşıldı (\`docs/117\` §0.1).

      Kimse kapalı bir bölümün içine dokunamaz; yalnız <summary> hedeftir.
  */
  const inClosedDetails = (el) => {
    for (let node = el.parentElement; node && node !== document.body; node = node.parentElement) {
      if (node.tagName === 'DETAILS' && !node.open) {
        const summary = node.querySelector(':scope > summary');
        return !(summary && summary.contains(el));
      }
    }
    return false;
  };

  const findings = [];

  // 1. Yatay taşma — BELGENİN kendisi kaymamalı.
  const docWidth = document.documentElement.scrollWidth;
  if (docWidth > W + 1) {
    /*
        Taşmaya sebep olan öğe kendi kaydırma kabında mı, yoksa gerçekten
        sayfayı mı geniyor? Kabı olan bir şerit taşma değildir; kabı olmayan
        bir tablo, kullanıcının bir daha bulamayacağı içeriktir.
    */
    let widest = null;
    for (const el of root.querySelectorAll('*')) {
      const r = el.getBoundingClientRect();
      if (r.right > W + 1 && !inHorizontalScroller(el)) {
        if (widest === null || r.right > widest.right) widest = { right: r.right, el };
      }
    }
    if (widest !== null) {
      findings.push({ kind: 'overflow-x', detail: docWidth + 'px > ' + W + 'px — ' + label(widest.el) });
    }
  }

  // 2/3/4. Etkileşimli öğeler.
  /*
      ODAKLANABİLİR OLMAK, DOKUNMA HEDEFİ OLMAK DEĞİLDİR.

      Genel bir [tabindex] seçicisi sekme panellerini de topluyordu; bir panel
      klavye için odaklanabilir ama kimse ona basmaz. Onları hedef saymak,
      "şu panel şu düğmeye 1 piksel yakın" gibi anlamsız bulgular üretti.
  */
  const interactive = [...root.querySelectorAll(
    'a[href], button, input, select, textarea, [role="button"], [role="link"], [role="switch"], [role="tab"], [role="checkbox"], [role="radio"], [role="menuitem"]'
  )].filter((el) => {
    const r = el.getBoundingClientRect();
    const s = getComputedStyle(el);
    return (
      r.width > 0 && r.height > 0 && s.visibility !== 'hidden' && s.display !== 'none'
      && !inClosedDetails(el)
    );
  });

  const boxes = [];

  for (const el of interactive) {
    const r = el.getBoundingClientRect();

    if ((r.right > W + 1 || r.left < -1) && !inHorizontalScroller(el)) {
      findings.push({ kind: 'clipped', detail: label(el) + ' → ' + Math.round(r.left) + '..' + Math.round(r.right) });
    }

    /*
        DOKUNULAN ŞEY, HEDEFTİR — girdinin kendisi değil.

        İki sahte kalıp ilk ölçümde 42 bulgu üretti:

        1. GÖRSEL OLARAK GİZLİ girdi (dosya seçici, atlama bağlantısı) 1×1
           pikseldir ve kimse ona dokunmaz; dokunulan şey onu saran bölge ya
           da odaklanınca beliren bağlantıdır.
        2. ONAY KUTUSU 16 pikseldir ama ETİKETİYLE birlikte tıklanır. Kutuyu
           tek başına ölçmek, kullanıcının gerçekte dokunduğu alanı yok
           saymaktır.

        Bu yüzden ölçülen kutu, varsa öğeyi saran etikettir.
    */
    if (r.width <= 1 || r.height <= 1) {
      boxes.push({ el, r });
      continue;
    }

    /*
        Etiket ya SARAR ya da for özniteliğiyle BAĞLANIR; ikisinde de tıklanabilir.
        Yalnız sarmalayanı aramak, for kullanan her onay kutusunu 16 piksel
        diye bildirirdi — ilk ölçümdeki en kalabalık sahte kalıp buydu.

        Bağlı etiket AYRI bir kutudur; gerçek hedef ikisinin BİRLEŞİMİDİR:
        kullanıcı ikisine de dokunabiliyor.
    */
    let target = r;
    const wrapping = el.closest('label');
    const linked = el.id ? document.querySelector('label[for="' + CSS.escape(el.id) + '"]') : null;
    const owner = wrapping ?? linked;

    if (owner) {
      const o = owner.getBoundingClientRect();
      target = {
        width: Math.max(r.right, o.right) - Math.min(r.left, o.left),
        height: Math.max(r.bottom, o.bottom) - Math.min(r.top, o.top),
      };
    }

    if (target.width < MIN_TARGET || target.height < MIN_TARGET) {
      findings.push({
        kind: 'small-target',
        detail: label(el) + ' → ' + Math.round(target.width) + '×' + Math.round(target.height)
          + (owner ? ' (etiketiyle)' : ''),
      });
    }

    boxes.push({ el, r });
  }

  for (let i = 0; i < boxes.length; i++) {
    for (let j = i + 1; j < boxes.length; j++) {
      const a = boxes[i].r, b = boxes[j].r;
      // İç içe geçmiş öğeler (bir düğmenin içindeki ikon bağlantısı gibi)
      // komşu sayılmaz; yalnız AYRIK kutular ölçülür.
      const nested = boxes[i].el.contains(boxes[j].el) || boxes[j].el.contains(boxes[i].el);
      if (nested) continue;
      const overlapX = a.left < b.right && b.left < a.right;
      const overlapY = a.top < b.bottom && b.top < a.bottom;
      if (overlapX && overlapY) continue;
      const gapX = overlapY ? Math.max(b.left - a.right, a.left - b.right) : Infinity;
      const gapY = overlapX ? Math.max(b.top - a.bottom, a.top - b.bottom) : Infinity;
      const gap = Math.min(gapX, gapY);
      /*
          AYRIM YALNIZ KÜÇÜK HEDEFLER İÇİN KUSURDUR.

          Tam genişlikte iki liste satırı arasında dört piksel boşluk yanlış
          dokunmaya yol açmaz: parmak zaten kocaman bir alana iniyor. Kusur,
          küçük bir hedefin komşusuna yapışmasıdır — orada bir milimetre
          kayma yanlış eylemi tetikler.
      */
      const eitherSmall =
        Math.min(a.width, a.height) < MIN_TARGET || Math.min(b.width, b.height) < MIN_TARGET;
      if (gap >= 0 && gap < MIN_GAP && eitherSmall) {
        findings.push({ kind: 'tight-gap', detail: label(boxes[i].el) + ' ↔ ' + label(boxes[j].el) + ' → ' + Math.round(gap) + 'px' });
      }
    }
  }

  // 5. Sessizce kırpılan metin.
  for (const el of root.querySelectorAll('*')) {
    if (el.children.length > 0) continue;
    const text = (el.textContent || '').trim();
    if (text === '') continue;
    if (inClosedDetails(el)) continue;
    const s = getComputedStyle(el);
    /*
        SATIR İÇİ ÖĞEDE scrollWidth/clientWidth ANLAMSIZDIR — ikisi de
        satır kutusunu değil, olmayan bir blok kutusunu tarif eder. Ölçmeye
        kalkmak, her span'i kırpılmış diye bildirir; ilk çalıştırmada
        tam olarak bu oldu (138 sahte bulgu).
    */
    if (s.display === 'inline') continue;
    /*
        EKRAN OKUYUCUYA ÖZEL METİN KIRPILMIŞ DEĞİLDİR.

        Görsel olarak gizlenen metin 1×1 piksellik bir kutuya sıkıştırılır ve
        taşması TASARIMIN kendisidir. İlk ölçümdeki 138 "sessiz kırpılma"
        bulgusunun neredeyse tamamı buydu — araç, erişilebilirlik için
        yazılmış metni kusur diye bildiriyordu.
    */
    const box = el.getBoundingClientRect();
    if (box.width <= 1 || box.height <= 1) continue;
    if (s.clipPath !== 'none' || s.clip !== 'auto') continue;
    if (s.overflow === 'visible' && s.overflowX === 'visible') continue;
    const clipped = el.scrollWidth > el.clientWidth + 1;
    if (clipped && s.textOverflow !== 'ellipsis') {
      findings.push({ kind: 'silent-truncation', detail: label(el) + ' → ' + el.scrollWidth + '>' + el.clientWidth });
    }
  }

  /*
      6. YATAY İSRAF — iç içe kapların dolgusu ne kadar yer yiyor?

      İlk sürüm "en derin metin taşıyan kutunun genişliği"ni ölçüyordu ve
      YANLIŞTI: ısı ızgarasının tek bir hücresi 34 piksel, ama bu bir dolgu
      israfı değil, hücrenin kendi boyu. Ölçüm 217 sahte bulgu üretti.

      Doğru soru şu: içerik EN SOLDA nereden başlıyor ve EN SAĞDA nerede
      bitiyor? Aradaki fark kullanılabilen genişliktir; kalanı iç içe
      dolguların toplamıdır. Sahibin şikâyeti birebir bu: "grid gap ve grid
      margin mobil cihazlarda fazla çalıyor ekrandan."
  */
  /*
      SÜS, İÇERİK DEĞİLDİR (2026-09-08 eklendi).

      Ölçüm "içerik en solda nereden başlıyor, en sağda nerede bitiyor"
      sorusunu soruyor. aria-hidden="true" bir alt ağaç bu sorunun cevabına
      giremez: orada duran şey tanımı gereği OKUNMAYAN bir katmandır.

      Somut arıza: kurumsal ana sayfanın akan bandı (docs/146 §4) iki özdeş
      kopya taşır — döngünün dikişsiz olması için — ve ikincisi görüntü
      alanının dışındadır. Bant overflow:clip ile kırpılıyor, yani ziyaretçi
      hiçbir zaman yatay kaydırmıyor; ama getBoundingClientRect kırpılmayı
      bilmez ve şeridin ikinci kopyası "içerik 320 piksel yerine 2764 piksel
      kullanıyor" dedirtiyordu. Sonuç bir HATA değil, daha kötüsüydü: oran
      eşiğin (%72) çok üstüne çıktığı için yoğunluk kuralı o sayfada
      SESSİZCE devre dışı kalıyordu.

      Kapsam DAR: yalnız bu ölçüm. Yatay taşma, kırpılma ve dokunma hedefi
      kuralları aria-hidden bir öğeyi eskisi gibi görür — dekoratif bir
      katman sayfayı yatay kaydırıyorsa bu yine bir kusurdur.
  */
  const isDecorative = (el) => el.closest('[aria-hidden="true"]') !== null;

  let minLeft = Infinity;
  let maxRight = -Infinity;

  for (const el of root.querySelectorAll('*')) {
    if (el.children.length > 0) continue;
    if ((el.textContent || '').trim() === '') continue;
    if (inHorizontalScroller(el)) continue;
    if (isDecorative(el)) continue;
    if (inClosedDetails(el)) continue;
    const r = el.getBoundingClientRect();
    if (r.width <= 0 || r.height <= 0) continue;
    if (r.left < minLeft) minLeft = r.left;
    if (r.right > maxRight) maxRight = r.right;
  }

  /*
      YATAY İSRAF YALNIZ EKRAN ÖLÇEĞİNDE ANLAMLIDIR.

      Bir avatar hikâyesi ortada 20 piksellik bir daire çizer; "kullanılabilir
      genişlik 20/320" demek, bileşenin kendi boyunu israf saymaktır. Ölçüm
      yalnız kökü gerçekten ekranı kaplayan hikâyelerde yapılır — yani bir
      EKRAN gibi davranan hikâyelerde. Diğerleri için sonuç "ölçülmedi"dir ve
      öyle raporlanır; "sorun yok" DEĞİL.
  */
  let widestBlock = 0;
  for (const child of root.children) {
    const r = child.getBoundingClientRect();
    if (r.width > widestBlock) widestBlock = r.width;
  }

  const screenScale = widestBlock >= W * 0.9;
  const usable = screenScale && maxRight > minLeft ? maxRight - minLeft : null;

  return {
    findings,
    usableWidth: usable === null ? null : Math.round(usable),
    leftInset: minLeft === Infinity ? null : Math.round(minLeft),
    rightInset: maxRight === -Infinity ? null : Math.round(W - maxRight),
    interactiveCount: interactive.length,
  };
})()`;

let nextId = 0;

function cdp(ws, method, params = {}) {
    const id = ++nextId;
    ws.send(JSON.stringify({ id, method, params }));
    return new Promise((resolve, reject) => {
        const onMessage = (event) => {
            const message = JSON.parse(event.data);
            if (message.id !== id) return;
            ws.removeEventListener('message', onMessage);
            message.error ? reject(new Error(message.error.message)) : resolve(message.result);
        };
        ws.addEventListener('message', onMessage);
        setTimeout(() => reject(new Error(`CDP timeout: ${method}`)), 30000);
    });
}

async function debuggerUrl(profile) {
    /* `--remote-debugging-port=0`: Chrome seçtiği portu profil dizinine yazar. */
    const marker = join(profile, 'DevToolsActivePort');

    for (let attempt = 0; attempt < 120; attempt++) {
        try {
            const [port] = readFileSync(marker, 'utf8').split('\n');
            const list = await fetch(`http://127.0.0.1:${port.trim()}/json/list`).then((r) =>
                r.json(),
            );
            const page = list.find((t) => t.type === 'page');
            if (page) return page.webSocketDebuggerUrl;
        } catch {
            /* Chrome henüz dinlemiyor ya da portu henüz yazmadı. */
        }
        await new Promise((r) => setTimeout(r, 250));
    }
    throw new Error('Chrome hata ayıklama portu açılmadı.');
}

/*
    HİKÂYE ÇİZİLMEDEN ÖLÇÜLMEZ.

    İlk sürüm gezinmeden sonra sabit 450 ms bekliyordu. Storybook her
    bileşen ailesini ayrı bir parça olarak tembel yükler ve o parçanın İLK
    hikâyesi 450 ms'de henüz çizilmemiş olabiliyordu: kök boş, gövde
    `sb-show-preparing-story`. Boş bir kökte hiçbir hedef yok, hiçbir taşma
    yok — yani "sorun yok". 2026-09-06'da ölçüldü: ısı ızgarasının dört
    hikâyesinden ilki 450 ms'de boştu ve "temiz" çıkıyordu, diğer üçü
    taşıyordu (`docs/117` §0.1).

    Şimdi araç, hikâyenin GERÇEKTEN çizildiğini bekler: gövdeden hazırlık
    sınıfı kalkmış, yazı tipleri yüklenmiş, iki çerçeve geçmiş. Süre dolarsa
    — ya da sayfa hiç yüklenmemişse — sonuç "temiz" DEĞİL, `not-rendered`:
    ölçülmemiş bir hikâye yeşil gösterilmez.
*/
const RENDER_DEADLINE_MS = 20000;

function readyExpression(storyId, budgetMs) {
    return `new Promise((resolve) => {
        const started = performance.now();
        const check = () => {
            if (new URL(location.href).searchParams.get('id') !== ${JSON.stringify(storyId)}) {
                return resolve('wrong-document');
            }
            const body = document.body.classList;
            if (body.contains('sb-show-errordisplay')) return resolve('error');
            if (body.contains('sb-show-main') && !body.contains('sb-show-preparing-story')) {
                document.fonts.ready.then(() =>
                    requestAnimationFrame(() => requestAnimationFrame(() => resolve('ready'))),
                );
                return;
            }
            if (performance.now() - started > ${Math.max(0, Math.round(budgetMs))}) {
                return resolve('timeout');
            }
            setTimeout(check, 50);
        };
        check();
    })`;
}

async function waitForStory(ws, storyId) {
    const started = Date.now();

    while (Date.now() - started < RENDER_DEADLINE_MS) {
        try {
            const { result } = await cdp(ws, 'Runtime.evaluate', {
                expression: readyExpression(storyId, RENDER_DEADLINE_MS - (Date.now() - started)),
                awaitPromise: true,
                returnByValue: true,
            });

            if (result.value === 'ready' || result.value === 'error') return result.value;
        } catch {
            /* Belge tam o anda değişti (gezinme sürüyor); yeniden sorulur. */
        }

        await new Promise((r) => setTimeout(r, 50));
    }

    return 'timeout';
}

/*
    DİZİN MUTLAK YOLA ÇEVRİLİR — ve bu, aracın ikinci yanılgısının kaydıdır.

    `node scripts/mobile-ux-audit storybook-static` göreli bir dizin verir.
    Göreli dizin `file://` adresine olduğu gibi yazılınca adres
    `file://storybook-static/iframe.html` olur: `storybook-static` artık
    bir dizin değil, bir SUNUCU ADIDIR ve Chrome o sunucuyu bulamaz. Ekranda
    Chrome'un kendi hata sayfası durur — 24 piksel kenar boşluğu, biraz
    metin, hiç hedef, hiç taşma.

    2026-09-06'da ölçülen buydu: 317 hikâyenin 317'si "kullanılabilir 272 /
    sol 24 / sağ 24" bildirdi ve sıfır bulgu çıktı; ısı ızgarasının bilinen
    taşması dahil. Sıfır bulgu bir ölçüm sonucu değildi, ölçümün YOKLUĞUYDU
    (`docs/117` §0.1). Aynı hata sayfası artık `not-rendered` diye
    raporlanır (aşağıda) — yeşil görünmez.
*/
/*
    Yol MUTLAKA mutlaklaştırılır: `file://` şemasında göreli bir yolun ilk
    parçası HOST olarak okunur (`file://storage/app/…`) ve sayfa sessizce
    hiç açılmaz. Ölçüm o zaman bir öncekinden kalan sayfayı ölçer — yani
    sessizce YANLIŞ bir rapor üretir, ki bu ölçüm yokluğundan kötüdür
    (`docs/117` §0).
*/
const targetDir = process.argv[2] ? resolve(process.argv[2]) : process.argv[2];

if (!targetDir || !existsSync(targetDir)) {
    console.error(
        'kullanım: scripts/mobile-ux-audit <storybook-static-dizini|html-dizini> ' +
            '[--json rapor.json] [--fail] [--baseline liste.json]',
    );
    process.exit(2);
}

/*
    İKİ KAYNAK, TEK ÖLÇÜM.

    Araç Storybook için yazıldı ve hikâyeleri ölçüyor. Ama kurumsal sitenin
    kabuğu bir React hikâyesi DEĞİL: sunucuda üretilen Blade. Onu ölçmenin
    tek dürüst yolu, gerçekten üretilen HTML'i ölçmektir — elle kopyalanmış
    bir düzenek, ölçtüğünü sandığı şeyden bir gün sessizce ayrışır
    (`docs/117` §4.2).

    Bu yüzden dizinde `index.json` varsa Storybook, yoksa düz HTML sayfaları
    ölçülür. Ölçüm motoru, eşikler ve kusur aileleri AYNI.
*/
const storybookMode = existsSync(join(targetDir, 'index.json'));

/*
    ÖLÇÜLEN YÖN.

    Varsayılan `ltr`; `--direction rtl` her hedefi sağdan sola açar.
    Tanınmayan bir değer sessizce `ltr`'ye düşmez — ölçüm yapıldığını
    sanmak, ölçüm yapmamaktan kötüdür.
*/
const directionFlag = process.argv.indexOf('--direction');
const DIRECTION = directionFlag > -1 ? (process.argv[directionFlag + 1] ?? '') : 'ltr';

if (DIRECTION !== 'ltr' && DIRECTION !== 'rtl') {
    console.error(
        `mobile-ux-audit: --direction yalnız "ltr" ya da "rtl" olabilir (gelen: ${DIRECTION}).`,
    );
    process.exit(2);
}

/** Dizindeki bütün HTML dosyaları, dizine göreli yollarıyla. */
function htmlFiles(dir, prefix = '') {
    const found = [];

    for (const entry of readdirSync(dir, { withFileTypes: true })) {
        const relative = prefix === '' ? entry.name : `${prefix}/${entry.name}`;

        if (entry.isDirectory()) {
            found.push(...htmlFiles(join(dir, entry.name), relative));
        } else if (entry.name.endsWith('.html')) {
            found.push(relative);
        }
    }

    return found.sort();
}

/*
    KAPALI BİR BÖLME, OLMAYAN BİR BÖLME DEĞİLDİR.

    Kabuğun gezintisi bir `<details>` içinde yaşıyor ve kapalıyken hiçbir
    bağlantı ölçülemez — araç "hedef yok" der ve menünün 320 pikselde nasıl
    davrandığını hiç sormaz. Kullanıcı o bölmeyi TEK dokunuşla açıyor;
    ölçülmesi gereken şey onun ulaştığı hâl. Bu yüzden sayfa kipinde bütün
    açılır bölmeler ölçümden önce açılır.
*/
/*
    SAYFA KİPİNDE YÖN `<html dir>` ÜZERİNDEN ÇEVRİLİR.

    Statik dışa aktarım İngilizce üretilir ve `<html dir="ltr">` taşır. Yönü
    burada çevirmek çeviri değildir: tek kelime değişmez, yalnız belge ters
    akar. Sunucu tarafında bunu yazan taraf `DocumentLocale::direction()` ve
    onun locale'den türediği ayrıca `tests/Feature/Rtl` altında ölçülüyor;
    burada ölçülen şey, o yön geldiğinde DÜZENİN ne yaptığı.
*/
/*
    ANİMASYON DONDURULUR — ölçümün kendisinden ÖNCE, ayrı bir adımda.

    Web Animations API doğrudan kullanılır: `document.getAnimations()` sayfadaki
    her animasyonu verir, `currentTime` ile sabit bir ana kurulur ve `pause()`
    orada durdurulur. CSS ile (`animation-play-state: paused`) denendi ve
    YETMEDİ — 2026-09-07'de ölçüldü: üç ardışık koşuda aynı hikâye 322, 323
    ve 324 piksel bildirdi, çünkü stilin uygulandığı an ile dönüşümün
    yeniden hesaplandığı çerçeve aynı görev içinde değil.

    Sıfır anına kurulmasının sebebi: dönen bir kare 0 derecede kendi
    kutusudur; ara açılarda eksen hizalı sınır kutusu 24 pikselden 34
    piksele kadar çıkar. Ölçüm o ara açıyı örneklerse, sonuç hangi
    milisaniyede bakıldığına bağlı olur — yani bir kapı değil, bir kumar.

    NE ÖLÇÜLMEZ: dönüşün ara açılarında oluşan geçici taşma. Tek bir değeri
    yok, dolayısıyla bir eşiği de olamaz. Gözlem `docs/132` §2'de sayılarıyla
    kayıtlıdır — sessizce yok sayılmıyor, ölçülemez olduğu yazılıyor.
*/
const FREEZE = `(() => {
  const style = document.createElement('style');
  style.textContent = '*, *::before, *::after { transition: none !important; }';
  document.head.appendChild(style);

  let frozen = 0;
  for (const animation of document.getAnimations()) {
    try { animation.currentTime = 0; animation.pause(); frozen += 1; } catch { /* bitmiş animasyon */ }
  }
  return new Promise((resolve) =>
    requestAnimationFrame(() => requestAnimationFrame(() => resolve(frozen))),
  );
})()`;

const PREPARE = (direction) => `(() => {
  document.documentElement.setAttribute('dir', ${JSON.stringify(direction)});
  for (const details of document.querySelectorAll('details')) details.open = true;
  return document.querySelectorAll('details').length;
})()`;

/** @type {{id: string, url: string, screen: boolean}[]} */
const targets = storybookMode
    ? Object.keys(JSON.parse(readFileSync(join(targetDir, 'index.json'), 'utf8')).entries).map(
          (id) => ({
              id,
              /*
                  Yön Storybook'un KENDİ global'i üzerinden çevrilir; ölçüm
                  böylece ürünün `withDirection` decorator'ünden geçer.
                  Hikâyenin kendi `globals`'ı (RTL hikâyeleri) adresteki
                  değeri geçersiz kılar — yani zaten RTL olan bir hikâye
                  LTR koşusunda da RTL kalır ve öyle raporlanır.
              */
              url:
                  `file://${join(targetDir, 'iframe.html')}?id=${id}&viewMode=story` +
                  (DIRECTION === 'rtl' ? '&globals=direction:rtl' : ''),
              /*
                  YATAY İSRAF YALNIZ EKRAN HİKÂYELERİNDE SORULUR.

                  `micro-` ve `compound-` hikâyeleri tek bir bileşeni ortada
                  çizer; "kullanılabilir genişlik 20/320" demek bir avatarın
                  kendi boyunu israf saymaktır. Soru ancak bir EKRANA
                  sorulabilir. Kapsam dışı hikâyeler "ölçülmedi" sayılır —
                  "sorun yok" DEĞİL.
              */
              screen: id.startsWith('surface-') || id.startsWith('macro-'),
          }),
      )
    : htmlFiles(targetDir).map((relative) => ({
          id: relative,
          url: `file://${join(targetDir, relative)}`,
          // Bir SAYFA her zaman bir ekrandır; genişliği sorulabilir.
          screen: true,
      }));

if (targets.length === 0) {
    console.error(`mobile-ux-audit: ${targetDir} içinde ölçülecek bir şey yok.`);
    process.exit(2);
}

const jsonFlag = process.argv.indexOf('--json');
const jsonOut = jsonFlag > -1 ? process.argv[jsonFlag + 1] : null;
const failOnFindings = process.argv.includes('--fail');

/*
    DONDURULMUŞ BORÇ — `--baseline`.

    Bugünkü borç bir kerede kapanamaz (67 hikâye, dört kusur ailesi;
    `docs/117`). Ama borcun BÜYÜMESİ bugünden durabilir: kapı yalnız listede
    OLMAYAN bir ihlalde kırılır.

    İki yönlü ölçülüyor ve ikincisi daha önemli: listedeki bir hikâye
    düzelirse kapı da kırılır ve liste güncellenmeye ZORLANIR. Aksi hâlde
    liste yıllarca eskir, içinde çoktan düzelmiş ekranlar taşır ve bir gün
    yeniden bozulduklarında hiçbir şey söylemez.
*/
const baselineFlag = process.argv.indexOf('--baseline');
const baselinePath = baselineFlag > -1 ? process.argv[baselineFlag + 1] : null;
const baseline =
    baselinePath && existsSync(baselinePath)
        ? JSON.parse(readFileSync(baselinePath, 'utf8')).stories
        : null;

const profileDir = mkdtempSync(join(tmpdir(), 'mobile-audit-'));

const chrome = spawn(
    CHROME,
    [
        '--headless=new',
        '--remote-debugging-port=0',
        `--user-data-dir=${join(profileDir, 'profile')}`,
        '--no-first-run',
        '--disable-gpu',
        '--allow-file-access-from-files',
        'about:blank',
    ],
    { stdio: 'ignore' },
);

const report = [];

try {
    const ws = new WebSocket(await debuggerUrl(join(profileDir, 'profile')));
    await new Promise((resolve, reject) => {
        ws.addEventListener('open', resolve, { once: true });
        ws.addEventListener('error', reject, { once: true });
    });

    await cdp(ws, 'Emulation.setDeviceMetricsOverride', {
        width: WIDTH,
        height: HEIGHT,
        deviceScaleFactor: 1,
        mobile: MOBILE,
    });
    await cdp(ws, 'Page.enable');

    for (const [position, target] of targets.entries()) {
        const storyId = target.id;

        await cdp(ws, 'Page.navigate', { url: target.url });

        let measured;

        /*
            YAZI TİPİ YÜKLENMEDEN ÖLÇÜM YAPILMAZ.

            Depo artık Roboto'yu kendi içinde barındırıyor, ama bir
            `@font-face` ANINDA hazır olmaz: tarayıcı önce HTML'i, sonra
            CSS'i okur, dosyayı ister ve `font-display: swap` altında bu
            arada YEDEK yazı tipiyle çizer. Sabit bir bekleme o pencereyi
            çoğu zaman kapatır — "çoğu zaman" ise ölçüm için yetersizdir.

            `document.fonts.ready` o belirsizliği kaldırır: ölçüm, sayfanın
            kullanacağı bütün yazı tipleri yerine oturduktan SONRA başlar.
            Hikâye kipinde de sayfa kipinde de geçerlidir; bu yüzden kip
            ayrımının ÖNÜNDE durur.
        */
        let fontsError = null;

        try {
            await cdp(ws, 'Runtime.evaluate', {
                expression: 'document.fonts.ready.then(() => document.fonts.status)',
                awaitPromise: true,
                returnByValue: true,
            });
        } catch (error) {
            fontsError = String(error);
        }

        if (fontsError !== null) {
            /*
                Yazı tipi beklenemediyse ölçüm YAPILMADI. Yedek yazı tipiyle
                alınmış bir sayı, ölçüm gibi görünen bir tahmindir.
            */
            measured = { findings: [{ kind: 'measure-failed', detail: fontsError }] };
        } else if (storybookMode) {
            const state = await waitForStory(ws, storyId);

            if (state === 'timeout') {
                measured = {
                    findings: [
                        {
                            kind: 'not-rendered',
                            detail: `${RENDER_DEADLINE_MS} ms içinde çizilmedi — ölçüm YAPILMADI, sonuç "bilinmiyor"`,
                        },
                    ],
                };
            } else if (state === 'error') {
                measured = {
                    findings: [{ kind: 'render-error', detail: 'Storybook hata ekranı gösterdi' }],
                };
            } else {
                /*
                    Kısa bir yerleşme payı: hikâye içindeki tembel (Suspense)
                    parçalar çerçeveden bir tık sonra gelebilir. Bu bir bekleme
                    değil, bir pay; hazır olma sinyalinin yerine geçmez.
                */
                await new Promise((r) => setTimeout(r, 150));

                try {
                    await cdp(ws, 'Runtime.evaluate', {
                        expression: FREEZE,
                        awaitPromise: true,
                        returnByValue: true,
                    });

                    const { result } = await cdp(ws, 'Runtime.evaluate', {
                        expression: MEASURE,
                        returnByValue: true,
                    });
                    measured = result.value;
                } catch (error) {
                    measured = { findings: [{ kind: 'measure-failed', detail: String(error) }] };
                }
            }
        } else {
            /*
                SAYFA KİPİ (statik dışa aktarım, #279): Storybook'un hazırlık
                sınıfı yok, dolayısıyla hazır sinyali de yok. Kısa sabit
                bekleme + açılır bölmelerin açılması (PREPARE) burada kalır;
                `not-rendered` ayrımı yalnız hikâyeler için ölçülebilir.
            */
            await new Promise((r) => setTimeout(r, 450));

            try {
                await cdp(ws, 'Runtime.evaluate', {
                    expression: PREPARE(DIRECTION),
                    returnByValue: true,
                });

                await cdp(ws, 'Runtime.evaluate', {
                    expression: FREEZE,
                    awaitPromise: true,
                    returnByValue: true,
                });

                const { result } = await cdp(ws, 'Runtime.evaluate', {
                    expression: MEASURE,
                    returnByValue: true,
                });
                measured = result.value;
            } catch (error) {
                measured = { findings: [{ kind: 'measure-failed', detail: String(error) }] };
            }
        }

        const findings = measured?.findings ?? [];

        if (
            target.screen &&
            measured?.usableWidth != null &&
            measured.usableWidth > 0 &&
            measured.usableWidth / WIDTH < MIN_CONTENT_RATIO
        ) {
            findings.push({
                kind: 'wasted-width',
                detail:
                    `kullanılabilir ${measured.usableWidth}px / ${WIDTH}px ` +
                    `(sol ${measured.leftInset}px, sağ ${measured.rightInset}px)`,
            });
        }

        report.push({
            storyId,
            findings,
            usableWidth: measured?.usableWidth ?? null,
            leftInset: measured?.leftInset ?? null,
            rightInset: measured?.rightInset ?? null,
        });

        if ((position + 1) % 50 === 0) {
            process.stderr.write(`  … ${position + 1}/${targets.length}\n`);
        }
    }

    ws.close();
} finally {
    chrome.kill();

    /*
        Chrome kapanırken profil dizinine hâlâ yazıyor olabilir; hemen silmek
        `ENOTEMPTY` ile patlıyordu ve BÜTÜN ÖLÇÜM raporlanmadan kayboluyordu.
        Temizlik bir ayrıntı, ölçüm sonucu değil: başarısız olursa sessizce
        geçilir.
    */
    await new Promise((r) => setTimeout(r, 500));

    try {
        rmSync(profileDir, { recursive: true, force: true });
    } catch {
        /* Geçici dizin işletim sistemine bırakılır. */
    }
}

const byKind = new Map();

for (const entry of report) {
    for (const finding of entry.findings) {
        if (!byKind.has(finding.kind)) byKind.set(finding.kind, []);
        byKind.get(finding.kind).push({ story: entry.storyId, detail: finding.detail });
    }
}

const affected = report.filter((entry) => entry.findings.length > 0).length;

console.log(`mobile-ux-audit · ${WIDTH}×${HEIGHT} · yön ${DIRECTION} · ${report.length} hikâye`);
console.log(`etkilenen hikâye: ${affected}/${report.length}`);
console.log('');

for (const [kind, items] of [...byKind.entries()].sort((a, b) => b[1].length - a[1].length)) {
    const stories = new Set(items.map((i) => i.story));
    console.log(`${kind}: ${items.length} bulgu, ${stories.size} hikâye`);
    for (const item of items.slice(0, 5)) {
        console.log(`    ${item.story} — ${item.detail}`);
    }
    if (items.length > 5) console.log(`    … ve ${items.length - 5} tane daha`);
    console.log('');
}

if (jsonOut) {
    writeFileSync(jsonOut, JSON.stringify({ width: WIDTH, height: HEIGHT, report }, null, 2));
    console.log(`ayrıntılı rapor: ${jsonOut}`);
}

if (baseline !== null) {
    const current = new Map(
        report
            .filter((entry) => entry.findings.length > 0)
            .map((entry) => [
                entry.storyId,
                [...new Set(entry.findings.map((f) => f.kind))].sort(),
            ]),
    );

    /*
        `wasted-width` YENİDEN KAPIDA — istisna KALDIRILDI, ölçüldü.

        2026-09-05'e kadar burada bir istisna vardı: `wasted-width` bulguları
        raporlanır ama kapıyı kırmazdı. Gerekçesi doğruydu — depo kendi yazı
        tipini barındırmıyordu, `--font-sans` "Roboto" diyordu ama tek bir
        `@font-face` yoktu, dolayısıyla her ortam kendi yedeğine düşüyordu
        (macOS SF Pro, CI'nin Linux'u DejaVu Sans). Metin kutularının
        uçlarından türeyen bir metrik, o zemin üzerinde ölçüm değil kumardı.

        Zemin değişti (FF-195): yazı tipi artık depoda
        (`resources/fonts/`, `resources/css/fonts.css`) ve ölçüm
        `document.fonts.ready` beklendikten SONRA yapılıyor. Yani her ortam
        aynı woff2 dosyasını okuyor.

        ÖLÇÜM (2026-09-05, aynı commit, aynı makine). Deney: yığının yedeği
        başka bir yüze çevrilip ("başka bir işletim sistemi" benzetimi) aynı
        denetim tekrar koşuldu.

          · Barındırmadan ÖNCE — 267 hikâyenin 109'unda kullanılabilir
            genişlik oynadı (en büyük fark 188px, ortalama 8.90px) ve 7
            hikâyenin kusur ailesi DEĞİŞTİ. Aralarında, bu istisnayı doğuran
            hikâye de vardı: `macro-layout-dashboardoverview--default`
            yalnız harfler değiştiği için `wasted-width`e düştü.
          · Barındırmadan SONRA — 268 hikâyenin 5'inde 4px oynama kaldı,
            ortalama 0.07px, ve kusur ailesi değişen hikâye SIFIR. Kalan beş
            hikâye `▲`/`▼` taşıyor; bu iki glif Roboto'nun barındırılmayan
            `symbols` alt kümesinde, yani hâlâ işletim sisteminden geliyor.
            Beşi de `micro-`/`compound-` hikâyesi, yani `wasted-width` onlara
            zaten SORULMUYOR — kapıya etkisi yok.
          · Dondurulmuş liste artık yazıldığı ortamdan farklı bir ortamda
            birebir tutuyor: 0 yeni ihlal, 0 düzelen. Öncesinde 1 sahte
            "düzeldi" satırı vardı (`surface-workspace-qrcodelistitem--named`).

        Yani istisnanın gerekçesi kalmadı. Gerekçesi kalmayan bir istisna
        kalırsa, korumayı kaldırdığı gerçek bulgular bir daha hiç görülmez.
    */
    const regressions = [];
    const improvements = [];

    for (const [storyId, kinds] of current) {
        const known = baseline[storyId];

        if (known === undefined) {
            regressions.push(`${storyId} — YENİ: ${kinds.join(', ')}`);
            continue;
        }

        for (const kind of kinds) {
            if (known.includes(kind)) continue;
            regressions.push(`${storyId} — yeni tür: ${kind}`);
        }
    }

    for (const storyId of Object.keys(baseline)) {
        if (!current.has(storyId)) {
            improvements.push(`${storyId} — DÜZELDİ, listeden çıkarılmalı`);
            continue;
        }

        for (const kind of baseline[storyId]) {
            if (!current.get(storyId).includes(kind)) {
                improvements.push(`${storyId} — ${kind} düzeldi, listeden çıkarılmalı`);
            }
        }
    }

    console.log(`dondurulmuş borç: ${Object.keys(baseline).length} hikâye`);
    console.log(`yeni ihlal: ${regressions.length} · düzelen: ${improvements.length}`);

    for (const line of [...regressions, ...improvements]) console.log(`    ${line}`);

    /*
        YALNIZ YENİ İHLAL KAPIYI KIRAR — düzelme KIRMAZ.

        Bu kararın ESKİ gerekçesi (ölçümün ortamdan ortama oynaması) FF-195
        ile ortadan kalktı: yazı tipi artık depoda ve aynı commit iki ortamda
        aynı sonucu veriyor. Yine de davranış korunuyor, çünkü kalan gerekçe
        ilkinden bağımsız ve hâlâ geçerli:

        Düzelme bir KUSUR DEĞİLDİR. Bir ekranı iyileştiren paketi, "listeyi
        de aynı pakette güncellemedin" diye kırmızıya düşürmek, iyileştirmeyi
        cezalandırır. Koruyucu yarı (yeni ihlal) katı kalıyor; tazelik yarısı
        raporlanıyor ve listeyi güncellemek bir karar olarak insana bırakılıyor.
    */
    if (improvements.length > 0) {
        console.log('');
        console.log('Düzelen satırlar `scripts/mobile-ux-audit.baseline.json` içinden SİLİNMELİ.');
        console.log('(Kapı bunun için kırılmaz: düzelme bir kusur değildir.)');
    }

    if (regressions.length > 0) {
        console.log('');
        console.log('Yeni ihlal DÜZELTİLİR — listeye eklenmez.');
        process.exit(1);
    }
}

if (failOnFindings && affected > 0) {
    process.exit(1);
}

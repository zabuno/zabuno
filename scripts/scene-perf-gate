#!/usr/bin/env node
/*
    SAHNE KARE SÜRESİ KAPISI — gerçek Chrome, gerçek kaydırma, gerçek CPU.

    ═══ NEDEN VAR ═══

    Bu deponun bütün arayüz testleri jsdom'da koşuyor ve jsdom bir kare bile
    ÇİZMEZ. Yani "sahne akıcı mı" sorusu, sahne yazıldıktan sonra bile
    sorulamaz durumdaydı — ve sorulmayan bir sorunun cevabı raporda "geçti"
    diye görünür.

    Ölçülen şey ÜÇ ayrı iddia:

      1. KARE SÜRESİ — sahne kaydırılırken kaç milisaniye sürüyor. Ortalama
         DEĞİL, p95: bir sahnenin akıcı hissedilmesini bozan şey ortalama
         değil, arada bir gelen uzun karedir.
      2. DERECELENDİRME — düşük güçlü bir cihazda sahne kendini SADELEŞTİRDİ
         mi. Kapının en önemli iddiası bu: "yavaş cihazda yavaş" bir kusur
         değil, "yavaş cihazda hâlâ tam yük" bir kusurdur.
      3. AZALTILMIŞ HAREKET — tercih açıkken hiçbir hareket kancasının
         yazılmadığı. Bu bir sayı değil bir OLGU ve ölçülmeden iddia edilemez.
      5. DOKUNMA KAMERASI (Döngü 2) — parmakla YATAY bir sürükleme sayfayı
         kaydırıyor mu. Sahne kamerayı sürüklemeye bağlıyor (`runtime.ts`) ve
         iddiası şu: `preventDefault()` HİÇ çağrılmıyor, yani dikey kaydırma
         her zaman tarayıcının. Bu iddia ölçülmeden edilemez; kaydırmayı
         çalan bir sahne, okunamayan bir sayfa demektir.
      4. İLK EKRAN (Döngü 2) — kahramandaki BİRİNCİL EYLEM kaç milisaniyede
         tam opak ve tıklanabilir oluyor. Gösteri, dönüşüm eylemini
         geciktiremez: bir giriş animasyonunun kuyruğunda bekleyen düğme,
         ziyaretçinin karar verdiği ilk saniyeyi harcar. Tavan 1000 ms ve
         düğme İLK EKRANIN İÇİNDE olmak zorunda — ölçülmeyen bir "görünüyor"
         iddiası, bir iddiadır.

    ═══ NEDEN CPU KISMA ═══

    Geliştirici makinesi ürünün en hızlı kullanıcısıdır. `--cpu 4`,
    Chrome'un kendi kısma düğmesiyle işlemciyi dörtte bire indirir; orta
    sınıf bir Android telefonun kabaca karşılığı. Kısmasız bir ölçüm
    "geçti" der ve sahibin telefonunda kare düşer.

    ═══ NE ÖLÇMÜYOR ═══

    GPU'nun kendisi. Chrome başsız kipte yazılım rasterleştirici (SwiftShader)
    kullanabilir; bu ölçümü GERÇEK bir cihazdan KÖTÜ yapar, iyi değil — yani
    kapı iyimser değil, kötümserdir. iOS Safari'nin kendi davranışını da
    doğrulamaz.

    ═══ KULLANIM ═══

        php artisan serve --port=8177 &
        node scripts/scene-perf-gate --url http://127.0.0.1:8177/ \
            --width 320 --height 480 --cpu 4 --json rapor.json [--fail]
*/

import { mkdirSync, writeFileSync } from 'node:fs';
import { join } from 'node:path';

import {
    cdp,
    closeChrome,
    connect,
    debuggerUrl,
    launchChrome,
    pinLanguage,
    requireChrome,
} from './browser-session.mjs';

const CHROME = requireChrome('scene-perf-gate');

function flag(name, fallback) {
    const index = process.argv.indexOf(`--${name}`);

    return index > -1 ? process.argv[index + 1] : fallback;
}

const URL_UNDER_TEST = flag('url', 'http://127.0.0.1:8000/');
const WIDTH = Number(flag('width', '320'));
const HEIGHT = Number(flag('height', '480'));
const CPU = Number(flag('cpu', '1'));
const SECONDS = Number(flag('seconds', '4'));
/*
    BÜTÇE. 60 kare/saniye 16,7 ms demektir; tavan 22 ms, yani ~45 fps.

    Neden tam 16,7 değil: bu ölçüm kısılmış bir CPU'da ve yazılım
    rasterleştiricide yapılıyor. Orada 16,7'yi şart koşmak, gerçek cihazda
    kolayca geçilen bir sahneyi kırar ve kapı gürültü üretir — gürültü üreten
    bir kapı kapatılır. 22 ms, "akıcı hissedilir"in alt sınırıdır.
*/
const BUDGET_MS = Number(flag('budget', '22'));
/*
    ÇEKİRDEK SAYISI TAKLİDİ — merdivenin GERÇEKTEN indiğini kanıtlar.

    Derecelendirme, cihaz ipuçlarına ve ölçülen kare süresine bakar. Bir
    geliştirici makinesinde ikisi de her zaman iyidir; yani "düşük güçlü
    cihazda sahne sadeleşiyor" cümlesi, taklit olmadan ölçülemez ve
    ölçülemeyen bir cümle bir iddiadır.

    `--concurrency 2` Chrome'un `navigator.hardwareConcurrency` değerini
    ikiye düşürür; `--expect-tier minimal` ile birlikte kapı, merdivenin
    o cihazda gerçekten indiğini ŞART KOŞAR.
*/
/*
    İLK EKRAN TAVANI. 1000 ms, ziyaretçinin sayfa hakkında karar verdiği
    saniyedir; bir eylem düğmesi o saniyenin içinde hem GÖRÜNÜR hem
    TIKLANABİLİR olmalı. Ölçüm kısılmış bir CPU'da yapılıyor, yani tavan
    gerçek bir cihazda geçilecek olandan sıkı.
*/
const FIRST_SCREEN_MS = Number(flag('first-screen-budget', '1000'));
/*
    SAHNENİN KENDİ TAVANI — ölçülerek seçildi.

    Düğme DOM'da göründükten sonra opak ve tıklanabilir olana kadar geçen
    süre. Ölçüm (2026-09-08, gerçek Chrome, CPU ×4, 320×480 ve 1280×800,
    on koşu): 0–4 ms. Sahne ilk ekrandaki `.scene-reveal` öğelerini gözlemciye
    hiç vermiyor (`depth.ts`, Döngü 2) ve bu sayı onun kanıtı.

    Tavan 120 ms: ölçülenin otuz katı bir pay değil, bir KARE BÜTÇESİ payı —
    en yavaş cihazda birkaç kare gecikme kusur değildir, bir giriş animasyonu
    kuyruğuna girmek kusurdur ve o, 700 ms'lik geçişiyle burayı anında aşar.
*/
const SCENE_DELAY_MS = Number(flag('scene-delay-budget', '120'));
/*
    NEDEN İKİ SAYI: `opaqueAt` ile `sceneDelayMs`.

    `opaqueAt` gezinmeden itibaren sayar, yani SUNUCUNUN yanıt süresini de
    içine alır. Ölçüldü (2026-09-08, aynı makine, aynı sayfa, arka arkaya üç
    koşu): 1199 / 222 / 948 ms — beş kata varan bir yayılma ve 1000 ms
    tavanının iki yanı. Sahnede değişen hiçbir şey yoktu; değişen şey
    `php artisan serve`in tek iş parçacıklı yanıt süresiydi. Kapı, sahne hiç
    dokunulmadığı hâlde koşuların üçte birinde kırmızı yanıyordu.

    Oynak bir kapı iki şeyden birini üretir: ya kapatılır ya da kırmızısına
    inanılmaz olur. İkisi de kapıyı yok eder. Bu yüzden ölçüm ikiye ayrıldı:
    düğme ne zaman DOĞDU (sunucunun payı, raporlanır) ve doğduktan sonra
    sahne onu ne kadar GECİKTİRDİ (sahnenin payı, kapı budur).
*/
const CONCURRENCY = flag('concurrency', null);
const EXPECT_TIER = flag('expect-tier', null);
const JSON_OUT = flag('json', null);
const DIAGNOSTICS_DIR = flag('diagnostics', null);
const SHOULD_FAIL = process.argv.includes('--fail');

/* CDP ve tarayıcı yaşam döngüsü ortak modülde (`browser-session.mjs`). */

async function evaluate(ws, expression) {
    const result = await cdp(ws, 'Runtime.evaluate', {
        expression,
        awaitPromise: true,
        returnByValue: true,
    });

    if (result.exceptionDetails) {
        throw new Error(result.exceptionDetails.text ?? 'sayfa içi hata');
    }

    return result.result.value;
}

/*
    ÖLÇÜM SAYFANIN İÇİNDE.

    Kareler dışarıdan sayılamaz: CDP üzerinden alınan her örnek, ölçtüğü
    şeyi yavaşlatır. Sayfa kendi karelerini sayar, sonuç TEK seferde
    dışarı çıkar.

    Kaydırma ölçümün PARÇASI: parallax, bölüm ilerlemesi ve giriş
    animasyonları yalnız kaydırırken çalışır. Duran bir sayfada ölçülen
    kare süresi, sahnenin en ucuz hâlidir ve hiçbir şey kanıtlamaz.
*/
/*
    İÇERİK SAYIMI — iki koşuda da AYNI ifade.

    Tek bir yerde durması şart: iki ayrı yere yazılmış iki sayım, ilk
    ayrışmada birbirini ölçmeyi bırakır ve "eşit mi" sorusu anlamını yitirir.
*/
const CONTENT_CENSUS = `({
    sections: document.querySelectorAll('main section').length,
    links: document.querySelectorAll('main a[href]').length,
    headings: document.querySelectorAll('main h1, main h2, main h3').length,
})`;

const sampler = (seconds) => `new Promise((resolve) => {
    const durationMs = ${Math.round(seconds * 1000)};
    const frames = [];
    const reach = Math.max(document.body.scrollHeight - window.innerHeight, 1);
    let previous = performance.now();
    const started = previous;

    const step = (now) => {
        frames.push(now - previous);
        previous = now;

        const progress = (now - started) / durationMs;
        /* Gidiş-dönüş: aşağı in, sonra geri çık. Tek yönlü bir kaydırma,
           bir kez doğan giriş animasyonlarını yalnız bir kez ölçerdi. */
        const wave = progress < 0.5 ? progress * 2 : (1 - progress) * 2;
        window.scrollTo(0, reach * Math.max(Math.min(wave, 1), 0));

        if (now - started < durationMs) {
            requestAnimationFrame(step);
        } else {
            /* İlk kare her zaman uzundur (ilk boyama, yazı tipi, gölgelendirici
               derlemesi). Onu ölçüme katmak, sahnenin SÜRDÜRÜLEBİLİR hızını
               değil, açılış maliyetini ölçmek olurdu — o ayrı bir soru. */
            const sorted = frames.slice(1).sort((a, b) => a - b);
            const at = (q) => sorted[Math.min(Math.floor(sorted.length * q), sorted.length - 1)] ?? 0;
            const canvas = document.querySelector('[data-scene="field"]');

            resolve({
                frames: sorted.length,
                p50: Number(at(0.5).toFixed(2)),
                p95: Number(at(0.95).toFixed(2)),
                max: Number((sorted[sorted.length - 1] ?? 0).toFixed(2)),
                longFrames: sorted.filter((ms) => ms > 50).length,
                tier: document.documentElement.dataset.sceneTier ?? null,
                motion: document.documentElement.dataset.motion ?? null,
                renderer: canvas ? (canvas.dataset.sceneRenderer ?? null) : null,
                live: canvas ? (canvas.dataset.sceneLive ?? null) : null,
                planes: document.querySelectorAll('[data-plane]').length,
                revealed: document.querySelectorAll('[data-revealed="true"]').length,
            });
        }
    };

    requestAnimationFrame(step);
})`;

/* Yalnız RED sonrasında, ayrı sayfa yüklemesi ve örnekleme penceresi.
   Trace ve kare günlüğü ölçümü yavaşlatabilir; kabul sonucu değildir. */
async function diagnoseFailure(ws, directory) {
    mkdirSync(directory, { recursive: true });
    const diagnostic = {
        acceptance: false,
        purpose: 'attribute-baseline-failure',
        limits: { deadlineMs: 45000, callTimeoutMs: 10000, traceBytes: 32 * 1024 * 1024 },
    };
    const deadline = Date.now() + diagnostic.limits.deadlineMs;
    const call = async (method, params = {}) => {
        const remaining = Math.min(diagnostic.limits.callTimeoutMs, deadline - Date.now());
        if (remaining <= 0) throw new Error('Diagnostic deadline exceeded');
        let timer;
        try {
            return await Promise.race([
                cdp(ws, method, params),
                new Promise((_, reject) => {
                    timer = setTimeout(
                        () => reject(new Error(`Diagnostic timeout: ${method}`)),
                        remaining,
                    );
                }),
            ]);
        } finally {
            clearTimeout(timer);
        }
    };
    const inspect = async (expression) => {
        const response = await call('Runtime.evaluate', {
            expression,
            awaitPromise: true,
            returnByValue: true,
        });
        if (response.exceptionDetails)
            throw new Error(response.exceptionDetails.text ?? 'Diagnostic evaluation failed');
        return response.result.value;
    };
    let tracing = false;
    let completionListener;
    let completionTimer;

    try {
        diagnostic.browser = await call('Browser.getVersion');
        await call('Emulation.setEmulatedMedia', {
            features: [{ name: 'prefers-reduced-motion', value: 'no-preference' }],
        });
        await call('Page.navigate', { url: URL_UNDER_TEST });
        await inspect(
            `new Promise((resolve) => {
            const check = () => document.readyState === 'complete'
                ? document.fonts.ready.then(() => setTimeout(resolve, 600))
                : setTimeout(check, 100);
            check();
        })`,
        );
        diagnostic.environment = await inspect(
            `(() => {
            window.__stopFirstScreenProbe?.();
            const canvas = document.querySelector('[data-scene="field"]');
            const gl = canvas?.dataset.sceneRenderer === 'webgl' ? canvas.getContext('webgl') : null;
            const debug = gl?.getExtension('WEBGL_debug_renderer_info');
            return {
                platform: navigator.platform, userAgent: navigator.userAgent,
                cores: navigator.hardwareConcurrency, memory: navigator.deviceMemory,
                dpr: devicePixelRatio, width: innerWidth, height: innerHeight,
                scrollHeight: document.body.scrollHeight,
                dark: matchMedia('(prefers-color-scheme: dark)').matches,
                renderer: canvas?.dataset.sceneRenderer ?? null,
                gpuVendor: debug ? gl.getParameter(debug.UNMASKED_VENDOR_WEBGL) : null,
                gpuRenderer: debug ? gl.getParameter(debug.UNMASKED_RENDERER_WEBGL) : null,
            };
        })()`,
        );
        await call('Tracing.start', {
            categories:
                'devtools.timeline,disabled-by-default-devtools.timeline,blink.user_timing,v8,cc,gpu,viz',
            transferMode: 'ReturnAsStream',
        });
        tracing = true;
        await inspect(
            `(() => {
            window.__sceneDiagnosticFrames = [];
            const started = performance.now();
            let previous = started;
            const tick = (now) => {
                window.__sceneDiagnosticFrames.push({
                    elapsedMs: now - started, deltaMs: now - previous,
                    scrollY, tier: document.documentElement.dataset.sceneTier ?? null,
                });
                previous = now;
                window.__sceneDiagnosticFrame = requestAnimationFrame(tick);
            };
            performance.mark('scene-diagnostic-start');
            window.__sceneDiagnosticFrame = requestAnimationFrame(tick);
        })()`,
        );
        diagnostic.sample = await inspect(sampler(SECONDS));
        diagnostic.frames = await inspect(
            `(() => {
            cancelAnimationFrame(window.__sceneDiagnosticFrame);
            performance.mark('scene-diagnostic-end');
            return window.__sceneDiagnosticFrames;
        })()`,
        );
    } catch (error) {
        diagnostic.error = error.message;
    } finally {
        if (tracing) {
            try {
                const completed = new Promise((resolve, reject) => {
                    completionListener = (event) => {
                        const message = JSON.parse(event.data);
                        if (message.method === 'Tracing.tracingComplete') resolve(message.params);
                    };
                    ws.addEventListener('message', completionListener);
                    completionTimer = setTimeout(
                        () => reject(new Error('Trace completion timed out')),
                        Math.max(1, Math.min(15000, deadline - Date.now())),
                    );
                });
                /* Attach the rejection handler before waiting for Tracing.end. */
                completed.catch(() => {});
                await call('Tracing.end');
                const { stream, dataLossOccurred } = await completed;
                diagnostic.traceDataLoss = Boolean(dataLossOccurred);
                if (!stream) throw new Error('Trace stream missing');
                const chunks = [];
                let bytes = 0;
                try {
                    for (let count = 0; ; count++) {
                        if (count >= 32) throw new Error('Trace exceeds 32 MiB diagnostic limit');
                        const chunk = await call('IO.read', { handle: stream, size: 1048576 });
                        const data = Buffer.from(
                            chunk.data,
                            chunk.base64Encoded ? 'base64' : 'utf8',
                        );
                        bytes += data.length;
                        if (bytes > diagnostic.limits.traceBytes)
                            throw new Error('Trace exceeds 32 MiB diagnostic limit');
                        chunks.push(data);
                        if (chunk.eof) break;
                    }
                    writeFileSync(join(directory, 'trace.json'), Buffer.concat(chunks));
                    diagnostic.trace = 'trace.json';
                } finally {
                    await call('IO.close', { handle: stream });
                }
            } catch (error) {
                diagnostic.traceError = error.message;
            } finally {
                clearTimeout(completionTimer);
                if (completionListener) ws.removeEventListener('message', completionListener);
            }
        }
        writeFileSync(
            join(directory, 'diagnostic.json'),
            `${JSON.stringify(diagnostic, null, 2)}\n`,
        );
    }
}

const { chrome, profileDir, profilePath } = launchChrome(CHROME, 'scene-perf-');

const report = {
    url: URL_UNDER_TEST,
    width: WIDTH,
    height: HEIGHT,
    cpu: CPU,
    concurrency: CONCURRENCY === null ? null : Number(CONCURRENCY),
    budgetMs: BUDGET_MS,
};
const findings = [];

try {
    const ws = await connect(await debuggerUrl(profilePath, chrome));

    await cdp(ws, 'Page.enable');
    /* Ölçülen sayfanın dili makinenin ayarı değil kapının kararı — gerekçe
       `browser-session.mjs` içinde. Kahramandaki birincil eylemin ETİKETİ
       dile göre değişir ve onun genişliği, "ilk ekranda mı" sorusunun
       cevabına girer. */
    await pinLanguage(ws);
    await cdp(ws, 'Emulation.setDeviceMetricsOverride', {
        width: WIDTH,
        height: HEIGHT,
        deviceScaleFactor: 1,
        mobile: WIDTH < 768,
    });

    /* --- 1. Hareket açıkken ------------------------------------------- */

    await cdp(ws, 'Emulation.setEmulatedMedia', {
        features: [{ name: 'prefers-reduced-motion', value: 'no-preference' }],
    });

    if (CPU > 1) {
        await cdp(ws, 'Emulation.setCPUThrottlingRate', { rate: CPU });
    }

    if (CONCURRENCY !== null) {
        await cdp(ws, 'Emulation.setHardwareConcurrencyOverride', {
            hardwareConcurrency: Number(CONCURRENCY),
        });
    }

    /*
        İLK EKRAN İZLEYİCİSİ — belge açılmadan ÖNCE kurulur.

        Sonradan sorulan bir soru ("şu an opak mı?") yalnız o anı ölçer ve
        aradaki en kötü kareyi kaçırır. Bu betik ilk kareden itibaren her
        karede bakar: düğme ne zaman TAM OPAK oldu, ne zaman gerçekten
        TIKLANABİLİR oldu (`elementFromPoint` ile: üstünü örten bir dekoratif
        katman varsa "görünür" olması bir şey ifade etmez).
    */
    await cdp(ws, 'Page.addScriptToEvaluateOnNewDocument', {
        source: `
            window.__firstScreen = {
                opaqueAt: null,
                hitAt: null,
                /* Düğmeyi ilk gördüğümüz an; gerekçe aşağıda, sayfa
                   kaynağının DIŞINDA yazılı (bu dize sayfaya gömülüyor). */
                firstSeenAt: null,
                minOpacity: 1,
                inFirstScreen: null,
            };
            let probeFrame = null;
            let stopped = false;
            window.__stopFirstScreenProbe = () => {
                stopped = true;
                if (probeFrame !== null) cancelAnimationFrame(probeFrame);
                probeFrame = null;
            };
            const tick = () => {
                if (stopped) return;
                /*
                    ÖLÇÜLEN ŞEY SAHNENİN KENDİ EYLEMİ.

                    Seçici "main [data-emphasis]" idi ve bu, iletişim
                    sayfasında formun EN ALTINDAKİ gönder düğmesini ölçüyordu
                    — "ilk ekranda değil" diye kırılıyordu, oysa bir form
                    düğmesinin ilk ekranda olması ne beklenir ne istenir.
                    Ölçülen şey artık yalnız bir SAHNE BANDININ içindeki
                    birincil eylem; sahnesinde eylem olmayan bir sayfada
                    ölçüm YAPILMAZ ve "geçti" de denmez.
                */
                const cta = document.querySelector('main .site-stage-content [data-emphasis="true"]');

                if (cta !== null) {
                    const box = cta.getBoundingClientRect();
                    const probe = window.__firstScreen;
                    /* Öğenin KENDİ opaklığı yetmez: giriş animasyonu ataya
                       yazılır. Zincir yukarı doğru çarpılır. */
                    let opacity = 1;

                    for (let node = cta; node !== null && node !== document.documentElement; node = node.parentElement) {
                        opacity *= Number(getComputedStyle(node).opacity);
                    }

                    if (box.width > 0) {
                        if (probe.firstSeenAt === null) {
                            probe.firstSeenAt = Math.round(performance.now());
                        }

                        probe.minOpacity = Math.min(probe.minOpacity, opacity);
                        probe.inFirstScreen = box.top >= 0 && box.bottom <= window.innerHeight;

                        if (opacity >= 0.99 && probe.opaqueAt === null) {
                            probe.opaqueAt = Math.round(performance.now());
                        }

                        if (probe.hitAt === null && probe.inFirstScreen) {
                            const hit = document.elementFromPoint(box.left + box.width / 2, box.top + box.height / 2);

                            if (hit !== null && (hit === cta || cta.contains(hit))) {
                                probe.hitAt = Math.round(performance.now());
                            }
                        }
                    }
                }

                if (performance.now() < 4000) {
                    probeFrame = requestAnimationFrame(tick);
                }
            };

            probeFrame = requestAnimationFrame(tick);
        `,
    });

    await cdp(ws, 'Page.navigate', { url: URL_UNDER_TEST });
    await evaluate(
        ws,
        `new Promise((resolve) => {
            const ready = () => document.readyState === 'complete';
            const check = () => (ready() ? document.fonts.ready.then(() => setTimeout(resolve, 600)) : setTimeout(check, 100));
            check();
        })`,
    );

    /* Sonucu dondurduktan sonra gözlemcinin stil/düzen okumaları artık
       kullanılmıyor. Kaydırmalı kare ölçümüne bu ek işi taşımayalım;
       opaklık, tıklanabilirlik ve eksik ölçüm kontrolleri aşağıda aynıdır. */
    report.firstScreen = await evaluate(
        ws,
        `(() => {
            window.__stopFirstScreenProbe?.();
            return window.__firstScreen ?? null;
        })()`,
    );

    if (report.firstScreen !== null && report.firstScreen.inFirstScreen !== null) {
        const { opaqueAt, hitAt, firstSeenAt, inFirstScreen, minOpacity } = report.firstScreen;

        /*
            SAHNENİN KENDİ PAYI.

            Düğme DOĞDUKTAN sonra opak ve tıklanabilir olana kadar geçen süre.
            Sunucunun yanıt gecikmesi bu farkın içinde YOKTUR; giriş
            animasyonu, gözlemci kuyruğu ve üstünü örten bir katman VARDIR —
            yani kapının kırılması artık yalnız sahnenin bir kusurunu
            gösterir.
        */
        report.firstScreen.sceneDelayMs =
            opaqueAt === null || firstSeenAt === null ? null : opaqueAt - firstSeenAt;
        report.firstScreen.sceneHitDelayMs =
            hitAt === null || firstSeenAt === null ? null : hitAt - firstSeenAt;
        report.firstScreen.budgetMs = SCENE_DELAY_MS;

        if (!inFirstScreen) {
            findings.push(
                `SAHNE-ILK-EKRAN: birincil eylem ${WIDTH}×${HEIGHT} ilk ekranın DIŞINDA. ` +
                    'Çağırdığı eylemi göstermeyen bir kahraman, bir kahraman değil bir kapak resmidir.',
            );
        }

        const { sceneDelayMs, sceneHitDelayMs } = report.firstScreen;

        if (sceneDelayMs === null || sceneDelayMs > SCENE_DELAY_MS) {
            findings.push(
                `SAHNE-ILK-EKRAN: birincil eylem doğduktan ${sceneDelayMs ?? '>4000'} ms sonra ` +
                    `tam opak oldu — tavan ${SCENE_DELAY_MS} ms (en düşük opaklık ` +
                    `${minOpacity}; toplam ${opaqueAt ?? '>4000'} ms, bunun ` +
                    `${firstSeenAt ?? '?'} ms'i sunucunun yanıt süresi). ` +
                    'GÖSTERİ, DÖNÜŞÜM EYLEMİNİ GECİKTİREMEZ.',
            );
        }

        if (sceneHitDelayMs === null || sceneHitDelayMs > SCENE_DELAY_MS) {
            findings.push(
                `SAHNE-ILK-EKRAN: birincil eylem doğduktan ${sceneHitDelayMs ?? '>4000'} ms ` +
                    `sonra tıklanabilir oldu — tavan ${SCENE_DELAY_MS} ms. Bir dekoratif ` +
                    'katman onu örtüyor olabilir.',
            );
        }

        /*
            TOPLAM SÜRE HÂLÂ RAPOR EDİLİR AMA KAPI DEĞİLDİR.

            Ziyaretçinin yaşadığı şey toplamdır ve o rakam raporda duruyor.
            Ama bu araç bir SAHNE kapısıdır: geliştirme sunucusunun yanıt
            süresini kırmızıya boyamak, sahne hiç değişmediği hâlde kırılan
            bir kapı üretir — ve gürültü üreten bir kapı kapatılır.
        */
        if (opaqueAt !== null && opaqueAt > FIRST_SCREEN_MS) {
            report.firstScreen.slowDelivery = true;
        }
    }

    report.motion = await evaluate(ws, sampler(SECONDS));

    /*
        İÇERİK SAYIMI, HAREKET AÇIKKEN.

        Aşağıdaki azaltılmış hareket koşusu bunun EŞİTİNİ görmek zorunda.
        Eski kapı sabit bir sayı arıyordu ("en az üç bölüm") ve o sayı ana
        sayfaya göre yazılmıştı: iki bölümlü bir fiyat sayfasında kapı,
        hiçbir kusur yokken kırılıyordu. Sabit bir eşik, ölçtüğü sayfayı
        varsayar; KARŞILAŞTIRMA hiçbir şey varsaymaz.
    */
    report.motion.content = await evaluate(ws, CONTENT_CENSUS);

    if (report.motion.motion !== 'on') {
        findings.push(
            'SAHNE-PERF: hareket açıkken `data-motion` yazılmamış — motor hiç ayağa ' +
                'kalkmamış ve ölçülen sayı sahneyi TEMSİL ETMİYOR.',
        );
    }

    if (EXPECT_TIER !== null && report.motion.tier !== EXPECT_TIER) {
        findings.push(
            `SAHNE-PERF: derece "${report.motion.tier}" — beklenen "${EXPECT_TIER}". ` +
                'Sahne gizlenmez, DERECELENİR; merdiven inmiyorsa düşük güçlü bir cihaz ' +
                'tam yükü taşımaya devam ediyor demektir.',
        );
    }

    if (report.motion.p95 > BUDGET_MS) {
        findings.push(
            `SAHNE-PERF: p95 kare süresi ${report.motion.p95} ms — bütçe ${BUDGET_MS} ms ` +
                `(${WIDTH}×${HEIGHT}, CPU ×${CPU}, derece "${report.motion.tier}").`,
        );
    }

    /* --- 2. Dokunma kamerası kaydırmayı çalmıyor ----------------------- */

    /*
        DOKUNMA TAKLİDİ ŞART.

        Kamera sürüklemesi yalnız `(pointer: fine)` YANLIŞKEN bağlanır. Masaüstü
        bir görüntü alanında dinleyici hiç kurulmaz ve ölçüm, ölçmediği bir şeye
        "geçti" derdi — ölçülmeyen bir kapı, kapı değildir.
    */
    if (WIDTH < 768) {
        await cdp(ws, 'Emulation.setTouchEmulationEnabled', { enabled: true, maxTouchPoints: 5 });
        await cdp(ws, 'Page.navigate', { url: URL_UNDER_TEST });
        await evaluate(
            ws,
            `new Promise((resolve) => {
                const check = () => (document.readyState === 'complete' ? setTimeout(resolve, 500) : setTimeout(check, 100));
                check();
            })`,
        );

        /* Sayfanın ortasına in: yukarıdan aşağı kaydırma imkânı da, yukarı
           kaydırma imkânı da açık olsun. Sayfanın tepesinde yapılan bir ölçüm,
           "kaydırma çalınmadı" cevabını bedavaya verirdi. */
        await evaluate(ws, 'new Promise((r) => { window.scrollTo(0, 400); setTimeout(r, 300); })');

        const before = await evaluate(ws, 'window.scrollY');
        const midY = Math.round(HEIGHT / 2);

        await cdp(ws, 'Input.dispatchTouchEvent', {
            type: 'touchStart',
            touchPoints: [{ x: Math.round(WIDTH / 2), y: midY }],
        });

        for (let step = 1; step <= 6; step += 1) {
            await cdp(ws, 'Input.dispatchTouchEvent', {
                type: 'touchMove',
                touchPoints: [{ x: Math.round(WIDTH / 2) - step * 12, y: midY }],
            });
        }

        await cdp(ws, 'Input.dispatchTouchEvent', { type: 'touchEnd', touchPoints: [] });
        await evaluate(ws, 'new Promise((r) => setTimeout(r, 400))');

        const after = await evaluate(ws, 'window.scrollY');

        /*
            VE ASIL SORU: DİKEY KAYDIRMA HÂLÂ ÇALIŞIYOR MU?

            "Yatay sürükleme kaydırmadı" tek başına iyi bir haber değil —
            hiçbir şeyin çalışmadığı bir sayfada da doğrudur. Ölçümün ikinci
            yarısı, `touch-action: pan-y`nin dikey kaydırmayı SERBEST
            bıraktığını kanıtlıyor. Kapı ancak ikisi birlikteyken bir şey söyler.
        */
        await cdp(ws, 'Input.dispatchTouchEvent', {
            type: 'touchStart',
            touchPoints: [{ x: Math.round(WIDTH / 2), y: midY + 90 }],
        });

        for (let step = 1; step <= 6; step += 1) {
            await cdp(ws, 'Input.dispatchTouchEvent', {
                type: 'touchMove',
                touchPoints: [{ x: Math.round(WIDTH / 2), y: midY + 90 - step * 14 }],
            });
        }

        await cdp(ws, 'Input.dispatchTouchEvent', { type: 'touchEnd', touchPoints: [] });
        await evaluate(ws, 'new Promise((r) => setTimeout(r, 500))');

        const afterVertical = await evaluate(ws, 'window.scrollY');

        report.touchCamera = {
            scrollBefore: before,
            afterHorizontalDrag: after,
            afterVerticalDrag: afterVertical,
        };

        if (before !== after) {
            findings.push(
                `SAHNE-DOKUNMA: yatay bir sürükleme sayfayı ${before} → ${after} kaydırdı. ` +
                    'Kamera sürüklemesi dikey kaydırmayı ÇALAMAZ; sahne, sayfayı okumanın ' +
                    'önüne geçemez.',
            );
        }

        if (afterVertical <= after) {
            findings.push(
                `SAHNE-DOKUNMA: dikey sürükleme sayfayı KAYDIRMADI (${after} → ` +
                    `${afterVertical}). Kamera sürüklemesi kaydırmayı yutmuş olabilir.`,
            );
        }

        await cdp(ws, 'Emulation.setTouchEmulationEnabled', { enabled: false });
    }

    /* --- 3. Azaltılmış hareket ----------------------------------------- */

    await cdp(ws, 'Emulation.setEmulatedMedia', {
        features: [{ name: 'prefers-reduced-motion', value: 'reduce' }],
    });
    await cdp(ws, 'Page.navigate', { url: URL_UNDER_TEST });
    await evaluate(
        ws,
        `new Promise((resolve) => {
            const check = () => (document.readyState === 'complete' ? setTimeout(resolve, 600) : setTimeout(check, 100));
            check();
        })`,
    );

    report.reduced = await evaluate(
        ws,
        `({
            motion: document.documentElement.dataset.motion ?? null,
            tier: document.documentElement.dataset.sceneTier ?? null,
            ...${CONTENT_CENSUS},
            hiddenReveals: Array.from(document.querySelectorAll('.scene-reveal'))
                .filter((el) => getComputedStyle(el).opacity === '0').length,
            animated: Array.from(document.querySelectorAll('main *'))
                .filter((el) => getComputedStyle(el).animationName !== 'none').length,
        })`,
    );

    if (report.reduced.motion !== null) {
        findings.push(
            'SAHNE-PERF: `prefers-reduced-motion: reduce` açıkken `data-motion` YAZILMIŞ. ' +
                'Parallax bazı insanlarda fiziksel rahatsızlık yapar; bu bir zevk meselesi değil.',
        );
    }

    if (report.reduced.animated > 0) {
        findings.push(
            `SAHNE-PERF: azaltılmış hareket açıkken ${report.reduced.animated} öğe hâlâ ` +
                'animasyon taşıyor.',
        );
    }

    if (report.reduced.hiddenReveals > 0) {
        findings.push(
            `SAHNE-PERF: azaltılmış hareket açıkken ${report.reduced.hiddenReveals} bölüm ` +
                'GİZLİ kalmış — sayfa eksik görünür. Giriş animasyonu, içeriği saklamanın ' +
                'gerekçesi olamaz.',
        );
    }

    /*
        AZALTILMIŞ HAREKET BİR "AZALTILMIŞ SÜRÜM" DEĞİLDİR.

        Aynı bölümler, aynı bağlantılar, aynı başlıklar — yalnız kıpırdamıyor.
        Karşılaştırma sabit bir eşikten üstün: hangi sayfada koşarsa koşsun
        aynı iddiayı ölçer ve yeni bir sayfa eklendiğinde güncellenmesi
        gerekmez.
    */
    for (const key of ['sections', 'links', 'headings']) {
        if (report.reduced[key] !== report.motion.content[key]) {
            findings.push(
                `SAHNE-PERF: azaltılmış hareket açıkken [${key}] sayısı ` +
                    `${report.reduced[key]} — hareketli hâlde ${report.motion.content[key]}. ` +
                    'Azaltılmış hareket bir "azaltılmış sürüm" DEĞİLDİR.',
            );
        }
    }

    if (report.reduced.sections === 0 || report.reduced.headings === 0) {
        findings.push(
            'SAHNE-PERF: azaltılmış hareket açıkken sayfada hiç bölüm ya da başlık yok — ' +
                'ölçülen şey bir sayfa değil.',
        );
    }

    if (DIAGNOSTICS_DIR !== null && findings.length > 0) {
        /* Kabul sonucu trace başlamadan diske alınır ve bir daha değiştirilmez.
           Teşhis başarılı olsa da hata verse de RED, RED olarak kalır. */
        mkdirSync(DIAGNOSTICS_DIR, { recursive: true });
        writeFileSync(
            join(DIAGNOSTICS_DIR, 'baseline.json'),
            `${JSON.stringify({ ...report, findings }, null, 2)}\n`,
        );
        try {
            await diagnoseFailure(ws, DIAGNOSTICS_DIR);
        } catch (error) {
            console.error(`SAHNE-TEŞHİS: ${error.message}; kabul sonucu değişmedi.`);
        }
    }

    ws.close();
} catch (error) {
    findings.push(`SAHNE-PERF: ölçüm yapılamadı — ${error.message}`);
} finally {
    /*
        Chrome ZATEN çıkmışsa `exit` olayı bir daha gelmez; eski kod tam
        orada asılıyordu ve kapı hiçbir şey basmadan bekliyordu. Ortak
        modül bu bekleyişi koşullu ve zaman aşımlı yapar.
    */
    await closeChrome(chrome, profileDir);
}

report.findings = findings;

const serialized = JSON.stringify(report, null, 2);
console.log(serialized);

if (JSON_OUT) {
    writeFileSync(JSON_OUT, `${serialized}\n`);
}

if (findings.length > 0 && SHOULD_FAIL) {
    process.exit(1);
}

#!/usr/bin/env node
/*
    GÖRSEL GERİLEME KAPISI — ekran görüntüsüyle (`docs/146` §9 madde 7 ve 8).

    ═══ NEDEN VAR ═══

    Döngü 1 iki eksiği yan yana yazmıştı ve ikisi de AYNI aracı bekliyordu:

      · madde 7 — *"Ekran görüntüsü kapısı yok. Sahne sabit tohumla çiziliyor,
        yani görsel bir gerileme testi mümkün — kurulmadı."*
      · madde 8 — *"`prefers-contrast: more` ve `forced-colors` görsel olarak
        doğrulanmadı. Kurallar yazıldı ve CSS'te duruyor; ekran görüntüsüyle
        bakılmadı."*

    Bu kapı ikisini birden kapatıyor.

    ═══ NEYİ ÖLÇÜYOR: DURAĞANLIK, SONRA GERİLEME ═══

    İki ayrı iddia, aynı ekran görüntüleriyle:

      1. **DURAĞANLIK.** Sahnenin hareketsiz olması GEREKEN dört hâlinde
         (azaltılmış hareket, `minimal` derece, yüksek kontrast, zorlanmış
         renkler) sayfa GERÇEKTEN kıpırdamıyor mu? Aynı ekrandan 900 ms arayla
         iki görüntü alınır ve BİRE BİR aynı olmaları şart koşulur. Bir
         `animation: none` yazmayı unutan tek satır burada yakalanır — CSS'i
         okuyarak değil, boyanan pikselle.

      2. **GERİLEME.** Aynı görüntülerin kaba bir imzası (16×12 hücrede
         ortalama parlaklık) `scene-visual.baseline.json` ile karşılaştırılır.
         Bir katmanın kazara gizlenmesi, bir kabın çökmesi ya da bir rengin
         ters dönmesi imzayı kaydırır.

    ═══ NEDEN HAREKETLİ HÂL KARŞILAŞTIRILMIYOR ═══

    Yıldız alanı sabit tohumlu (`field.ts`), yani aynı GÖKYÜZÜ doğuyor — ama
    aynı AN doğmuyor: yıldızlar `u_time` ile ilerliyor ve iki koşuda aynı
    milisaniyede yakalanamazlar. Hareketli bir kareyi "aynı olmalı" diye şart
    koşmak, her koşuda rastgele kırılan bir kapı olurdu ve gürültü üreten bir
    kapı kapatılır.

    Hareketli hâl yine de YAZILIR (`--png` ile) ama KARŞILAŞTIRILMAZ; insan
    gözü için, kapı için değil. Bu kapı hareketin GÜZEL olduğunu iddia etmiyor;
    hareketin OLMAMASI gereken yerde olmadığını kanıtlıyor.

    ═══ NE ÖLÇMÜYOR ═══

    Renk doğruluğu, yazı tipi tırtıklanması ve GPU rasterleştirmesi. Başsız
    Chrome yazılım rasterleştirici kullanabilir; imza 16×12 hücrede
    ortalandığı için bu fark kapıyı kırmaz ama aynı sebeple ince bir tipografi
    gerilemesini de görmez.

    ═══ KULLANIM ═══

        php artisan serve --port=8177 &
        node scripts/scene-visual-gate --base http://127.0.0.1:8177 [--fail]
        node scripts/scene-visual-gate --base … --update     # taban yenile
        node scripts/scene-visual-gate --base … --png /tmp/g  # göz için PNG
*/

import { spawn } from 'node:child_process';
import { existsSync, mkdirSync, mkdtempSync, readFileSync, rmSync, writeFileSync } from 'node:fs';
import { tmpdir } from 'node:os';
import { dirname, join } from 'node:path';
import { fileURLToPath } from 'node:url';
import { inflateSync } from 'node:zlib';

const ROOT = join(dirname(fileURLToPath(import.meta.url)), '..');

const CHROME_CANDIDATES = [
    process.env.CHROME_PATH,
    '/Applications/Google Chrome.app/Contents/MacOS/Google Chrome',
    '/usr/bin/google-chrome',
    '/usr/bin/google-chrome-stable',
    '/usr/bin/chromium',
    '/usr/bin/chromium-browser',
].filter(Boolean);

const CHROME = CHROME_CANDIDATES.find((candidate) => existsSync(candidate));

if (CHROME === undefined) {
    console.error('scene-visual-gate: Chrome bulunamadı — ölçüm YAPILMADI, sonuç "bilinmiyor".');
    process.exit(2);
}

function flag(name, fallback) {
    const index = process.argv.indexOf(`--${name}`);

    return index > -1 ? process.argv[index + 1] : fallback;
}

const BASE = flag('base', 'http://127.0.0.1:8000').replace(/\/$/, '');
const BASELINE = flag('baseline', join(ROOT, 'scripts/scene-visual.baseline.json'));
const PNG_DIR = flag('png', null);
const SHOULD_UPDATE = process.argv.includes('--update');
const SHOULD_FAIL = process.argv.includes('--fail');

/*
    HANGİ SAYFA, HANGİ GENİŞLİK.

    Dört sayfa: Döngü 2'de sahnenin yayıldığı her yüzey. 320 taban, 1280
    geniş ekran. Her sayfa her genişlikte çekilmiyor — kapı ne kadar uzun
    koşarsa o kadar seyrek koşturulur ve koşulmayan bir kapı yoktur.
*/
const PAGES = [
    { key: 'home', path: '/', widths: [320, 1280] },
    { key: 'pricing', path: '/pricing', widths: [320, 1280] },
    { key: 'about', path: '/about', widths: [320] },
    { key: 'contact', path: '/contact', widths: [320] },
];

/*
    DURAĞAN OLMASI GEREKEN DÖRT HÂL.

    Dördü de bu deponun KENDİ sözleşmesinin sonucudur; hiçbiri tarayıcının
    varsayılan davranışı değil:

      · `reduce`   — `prefers-reduced-motion` mutlaktır: motor HİÇ başlamaz.
      · `minimal`  — iki çekirdekli bir cihazda tuval boyanmaz, atmosfer durur.
      · `contrast` — `prefers-contrast: more` bir tercih değil bir İHTİYAÇTIR.
      · `forced`   — zorlanmış renklerde sistem paleti hükmeder.
*/
const STATES = {
    reduce: { media: [{ name: 'prefers-reduced-motion', value: 'reduce' }], static: true },
    minimal: {
        media: [{ name: 'prefers-reduced-motion', value: 'no-preference' }],
        concurrency: 2,
        static: true,
    },
    contrast: {
        media: [
            { name: 'prefers-reduced-motion', value: 'no-preference' },
            { name: 'prefers-contrast', value: 'more' },
        ],
        static: true,
    },
    forced: {
        media: [
            { name: 'prefers-reduced-motion', value: 'no-preference' },
            { name: 'forced-colors', value: 'active' },
        ],
        static: true,
    },
    /* Hareketli hâl: yalnız göz için yazılır, karşılaştırılmaz. */
    motion: { media: [{ name: 'prefers-reduced-motion', value: 'no-preference' }], static: false },
};

/* --- PNG çözücü ---------------------------------------------------------

   ═══ NEDEN ELLE ═══

   Bu depoda görüntü çözen bir bağımlılık yok ve bir kapı uğruna eklemek,
   üretim paketine hiç girmeyecek bir paketi kilit dosyasına yazmak olurdu.
   Chrome'un ürettiği PNG dar bir kümedir: 8 bit, geçişsiz (interlace yok),
   RGB ya da RGBA. Aşağıdaki çözücü tam olarak o kümeyi okur ve başka bir
   şeyle karşılaşırsa SESSİZCE YANLIŞ CEVAP VERMEZ — hata fırlatır.
*/
function decodePng(buffer) {
    if (buffer.readUInt32BE(0) !== 0x89504e47) {
        throw new Error('PNG imzası yok.');
    }

    let offset = 8;
    let width = 0;
    let height = 0;
    let channels = 0;
    const parts = [];

    while (offset < buffer.length) {
        const length = buffer.readUInt32BE(offset);
        const type = buffer.toString('ascii', offset + 4, offset + 8);
        const data = buffer.subarray(offset + 8, offset + 8 + length);
        offset += length + 12;

        if (type === 'IHDR') {
            width = data.readUInt32BE(0);
            height = data.readUInt32BE(4);
            const depth = data[8];
            const colorType = data[9];
            const interlace = data[12];

            if (depth !== 8 || interlace !== 0 || (colorType !== 2 && colorType !== 6)) {
                throw new Error(`Desteklenmeyen PNG (derinlik ${depth}, tür ${colorType}).`);
            }

            channels = colorType === 6 ? 4 : 3;
        } else if (type === 'IDAT') {
            parts.push(data);
        } else if (type === 'IEND') {
            break;
        }
    }

    const raw = inflateSync(Buffer.concat(parts));
    const stride = width * channels;
    const pixels = Buffer.alloc(height * stride);

    for (let y = 0; y < height; y += 1) {
        const filter = raw[y * (stride + 1)];
        const line = raw.subarray(y * (stride + 1) + 1, y * (stride + 1) + 1 + stride);
        const out = pixels.subarray(y * stride, (y + 1) * stride);
        const prior = y === 0 ? null : pixels.subarray((y - 1) * stride, y * stride);

        for (let x = 0; x < stride; x += 1) {
            const a = x >= channels ? out[x - channels] : 0;
            const b = prior === null ? 0 : prior[x];
            const c = prior === null || x < channels ? 0 : prior[x - channels];
            let value = line[x];

            if (filter === 1) value += a;
            else if (filter === 2) value += b;
            else if (filter === 3) value += (a + b) >> 1;
            else if (filter === 4) {
                const p = a + b - c;
                const pa = Math.abs(p - a);
                const pb = Math.abs(p - b);
                const pc = Math.abs(p - c);
                value += pa <= pb && pa <= pc ? a : pb <= pc ? b : c;
            }

            out[x] = value & 255;
        }
    }

    return { width, height, channels, pixels };
}

/*
    İMZA — 16×12 hücrede ortalama parlaklık.

    Piksel piksel karşılaştırma, yazı tipi tırtıklanmasındaki tek piksellik
    farkta bile kırılır ve o kapı bir hafta içinde kapatılır. Kaba bir ızgara
    ise GÖRÜNEN şeyi ölçer: bir katmanın kaybolması, bir kabın çökmesi, bir
    rengin ters dönmesi. Ölçtüğü şey estetik değil BÜTÜNLÜK.
*/
const CELLS_X = 16;
const CELLS_Y = 12;

function signature(image) {
    const { width, height, channels, pixels } = image;
    const out = [];

    for (let cy = 0; cy < CELLS_Y; cy += 1) {
        for (let cx = 0; cx < CELLS_X; cx += 1) {
            const x0 = Math.floor((cx * width) / CELLS_X);
            const x1 = Math.max(Math.floor(((cx + 1) * width) / CELLS_X), x0 + 1);
            const y0 = Math.floor((cy * height) / CELLS_Y);
            const y1 = Math.max(Math.floor(((cy + 1) * height) / CELLS_Y), y0 + 1);
            let sum = 0;
            let count = 0;

            for (let y = y0; y < y1; y += 2) {
                for (let x = x0; x < x1; x += 2) {
                    const i = (y * width + x) * channels;
                    /* Rec. 601 parlaklığı: göz yeşili kırmızıdan, kırmızıyı
                       maviden fazla görür. Düz ortalama, mavi bir sahnede
                       gerçek parlaklığı olduğundan yüksek gösterirdi. */
                    sum += 0.299 * pixels[i] + 0.587 * pixels[i + 1] + 0.114 * pixels[i + 2];
                    count += 1;
                }
            }

            out.push(Math.round(sum / Math.max(count, 1)));
        }
    }

    return out;
}

/* --- CDP ---------------------------------------------------------------- */

let nextId = 0;

function cdp(ws, method, params = {}) {
    const id = ++nextId;
    ws.send(JSON.stringify({ id, method, params }));

    return new Promise((resolve, reject) => {
        const onMessage = (event) => {
            const message = JSON.parse(event.data);

            if (message.id !== id) return;

            ws.removeEventListener('message', onMessage);
            message.error
                ? reject(new Error(`${method}: ${message.error.message}`))
                : resolve(message.result);
        };

        ws.addEventListener('message', onMessage);
        setTimeout(() => reject(new Error(`CDP timeout: ${method}`)), 60000);
    });
}

async function debuggerUrl(profile) {
    const marker = join(profile, 'DevToolsActivePort');

    for (let attempt = 0; attempt < 160; attempt += 1) {
        try {
            const [port] = readFileSync(marker, 'utf8').split('\n');
            const list = await fetch(`http://127.0.0.1:${port.trim()}/json/list`).then((r) =>
                r.json(),
            );
            const page = list.find((t) => t.type === 'page');

            if (page) return page.webSocketDebuggerUrl;
        } catch {
            /* Chrome henüz dinlemiyor. */
        }

        await new Promise((r) => setTimeout(r, 250));
    }

    throw new Error('Chrome hata ayıklama portu açılmadı.');
}

async function settle(ws, ms) {
    await cdp(ws, 'Runtime.evaluate', {
        expression: `new Promise((resolve) => {
            const done = () => document.fonts.ready.then(() => setTimeout(resolve, ${ms}));
            const check = () => (document.readyState === 'complete' ? done() : setTimeout(check, 80));
            check();
        })`,
        awaitPromise: true,
    });
}

const profileDir = mkdtempSync(join(tmpdir(), 'scene-visual-'));
const chrome = spawn(
    CHROME,
    [
        '--headless=new',
        '--remote-debugging-port=0',
        `--user-data-dir=${join(profileDir, 'profile')}`,
        '--no-first-run',
        '--hide-scrollbars',
        '--force-device-scale-factor=1',
        '--enable-unsafe-swiftshader',
        'about:blank',
    ],
    { stdio: 'ignore' },
);

const baseline = existsSync(BASELINE) ? JSON.parse(readFileSync(BASELINE, 'utf8')) : { views: {} };
const report = { base: BASE, cells: `${CELLS_X}x${CELLS_Y}`, views: {} };
const findings = [];
const next = { views: {} };

if (PNG_DIR !== null) {
    mkdirSync(PNG_DIR, { recursive: true });
}

try {
    const ws = new WebSocket(await debuggerUrl(join(profileDir, 'profile')));
    await new Promise((resolve, reject) => {
        ws.addEventListener('open', resolve, { once: true });
        ws.addEventListener('error', reject, { once: true });
    });

    await cdp(ws, 'Page.enable');

    for (const page of PAGES) {
        for (const width of page.widths) {
            for (const [stateName, state] of Object.entries(STATES)) {
                const view = `${page.key}-${width}-${stateName}`;

                await cdp(ws, 'Emulation.setDeviceMetricsOverride', {
                    width,
                    height: width < 768 ? 480 : 800,
                    deviceScaleFactor: 1,
                    mobile: width < 768,
                });
                await cdp(ws, 'Emulation.setEmulatedMedia', { features: state.media });
                await cdp(ws, 'Emulation.setHardwareConcurrencyOverride', {
                    hardwareConcurrency: state.concurrency ?? 8,
                });

                await cdp(ws, 'Page.navigate', { url: `${BASE}${page.path}` });
                await settle(ws, 700);

                const first = await cdp(ws, 'Page.captureScreenshot', { format: 'png' });
                const firstImage = decodePng(Buffer.from(first.data, 'base64'));
                const firstSignature = signature(firstImage);

                if (PNG_DIR !== null) {
                    writeFileSync(join(PNG_DIR, `${view}.png`), Buffer.from(first.data, 'base64'));
                }

                if (!state.static) {
                    report.views[view] = { compared: false };
                    continue;
                }

                /*
                    DURAĞANLIK KANITI.

                    900 ms sonra ikinci bir kare. Aynı olmalılar — çünkü bu
                    dört hâlin SÖZLEŞMESİ hareketsizliktir. `animation: none`
                    yazmayı unutan tek bir satır burada, CSS okunarak değil
                    boyanan pikselle yakalanır.
                */
                await new Promise((resolve) => setTimeout(resolve, 900));

                const second = await cdp(ws, 'Page.captureScreenshot', { format: 'png' });
                const secondSignature = signature(decodePng(Buffer.from(second.data, 'base64')));
                const moved = firstSignature.reduce(
                    (worst, value, index) =>
                        Math.max(worst, Math.abs(value - secondSignature[index])),
                    0,
                );

                if (moved > 0) {
                    findings.push(
                        `SAHNE-GORSEL: [${view}] hareketsiz olmalıydı ama 900 ms sonra ` +
                            `değişti (en büyük hücre farkı ${moved}/255). Bu hâlin sözleşmesi ` +
                            'HAREKETSİZLİKTİR.',
                    );
                }

                next.views[view] = firstSignature;

                const known = baseline.views?.[view];

                if (known === undefined) {
                    if (!SHOULD_UPDATE) {
                        findings.push(
                            `SAHNE-GORSEL: [${view}] için taban yok. Sonuç "geçti" DEĞİL ` +
                                '"bilinmiyor" — `--update` ile taban yazılmalı.',
                        );
                    }

                    report.views[view] = { compared: false, drift: null };
                    continue;
                }

                const drift = firstSignature.reduce(
                    (worst, value, index) => Math.max(worst, Math.abs(value - known[index])),
                    0,
                );

                report.views[view] = { compared: true, drift };

                /*
                    TOLERANS 8/255.

                    Sıfır tolerans, iki farklı makinede farklı rasterleştirici
                    kullanan Chrome'da her koşuda kırılırdı. 8, gözle
                    ayırt edilemeyen bir farktır; bir katmanın kaybolması ya da
                    bir kabın çökmesi ise onlarca birim kaydırır.
                */
                if (drift > 8) {
                    findings.push(
                        `SAHNE-GORSEL: [${view}] tabandan ${drift}/255 saptı. Bir katman ` +
                            'kaybolmuş, bir kap çökmüş ya da bir renk ters dönmüş olabilir.',
                    );
                }
            }
        }
    }

    ws.close();
} catch (error) {
    findings.push(`SAHNE-GORSEL: ölçüm yapılamadı — ${error.message}`);
} finally {
    chrome.kill();
    await new Promise((resolve) => chrome.once('exit', resolve));

    try {
        rmSync(profileDir, { recursive: true, force: true, maxRetries: 5, retryDelay: 200 });
    } catch {
        /* Geçici dizin işletim sistemine bırakılır. */
    }
}

if (SHOULD_UPDATE && findings.every((finding) => !finding.includes('ölçüm yapılamadı'))) {
    writeFileSync(
        BASELINE,
        `${JSON.stringify(
            {
                requirement: 'SAHNE-GORSEL-01',
                why:
                    'Kaba görsel imza (16×12 hücrede ortalama parlaklık). Hareketsiz olması ' +
                    'gereken dört hâl burada dondurulur: azaltılmış hareket, minimal derece, ' +
                    'yüksek kontrast, zorlanmış renkler. Hareketli hâl KARŞILAŞTIRILMAZ — ' +
                    'yıldızlar sabit tohumlu ama aynı milisaniyede yakalanamaz.',
                cells: { x: CELLS_X, y: CELLS_Y },
                views: next.views,
            },
            null,
            4,
        )}\n`,
    );
}

report.findings = findings;
console.log(JSON.stringify(report, null, 2));

if (findings.length > 0 && SHOULD_FAIL) {
    process.exit(1);
}

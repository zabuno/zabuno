function flag(name, fallback) {
    const index = process.argv.indexOf(`--${name}`);

    return index > -1 ? process.argv[index + 1] : fallback;
}

const BASE = flag('base', 'http://127.0.0.1:8000').replace(/\/$/, '');
const BASELINE_PATH = flag('baseline', join(ROOT, 'scripts/wcag-gate.baseline.json'));
const JSON_OUT = flag('json', null);
const ONLY = flag('only', null);
const SHOULD_UPDATE = process.argv.includes('--update');
const SHOULD_FAIL = process.argv.includes('--fail');

/*
    `--motion` — SAHNE BOYANMIŞ HÂLDE ÖLÇÜM.

    Varsayılan ölçüm `prefers-reduced-motion: reduce` altındadır ve bunun tek
    sebebi TEKRARLANABİLİRLİKTİR: o hâlde sahne motoru hiç başlamaz (deponun
    kendi sözleşmesi, `docs/146`), yani her koşuda aynı pikseller boyanır ve
    bir kapı ancak tekrarlanabilirse kapı olur.

    Ama ziyaretçilerin ÇOĞU o hâlde değildir: onlarda yıldız alanı boyanır ve
    metnin arkasındaki parlaklık değişir. `--motion` tam olarak o hâli ölçer.
    Sonucu tabana BAĞLANMAZ — hareketli bir sahnede sayı koşudan koşuya
    oynar ve oynayan bir sayıya bağlanan kapı bir hafta içinde kapatılır.
    İnsan için ölçülür, kapı için değil.
*/
const MOTION = process.argv.includes('--motion');

/*
    `--state` — KULLANICININ İLAN ETTİĞİ İHTİYAÇ.

    Üç hâl ölçülebilir ve üçü de aynı sayfanın FARKLI hâlleridir:

      · `default`  — hiçbir tercih ilan edilmemiş.
      · `contrast` — `prefers-contrast: more`. Bu bir zevk değil bir
        İHTİYAÇTIR: ilan eden kişi varsayılan hâlde okuyamıyordur. Sitenin o
        hâlde GERÇEKTEN daha kontrastlı boyandığı bugüne kadar ekran
        görüntüsüyle bakılmıştı, SAYIYLA değil.
      · `forced`   — `forced-colors: active`. Sistem paleti hükmeder; burada
        ölçülen şey sitenin o paleti BOZUP bozmadığıdır (metni bir tuvale ya
        da arka plan görüntüsüne gömen bir sayfa, zorlanmış renklerde
        kaybolur).
*/
const STATE = flag('state', 'default');

if (!['default', 'contrast', 'forced'].includes(STATE)) {
    console.error(`wcag-gate: bilinmeyen hâl "${STATE}" (default | contrast | forced).`);
    process.exit(2);
}


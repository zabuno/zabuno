          \$s->put('login_web_'.sha1(Illuminate\Auth\SessionGuard::class), \$u->id);
          \$s->save();
          \$n = config('session.cookie'); \$e = app('encrypter');
          echo \$n.'='.rawurlencode(\$e->encrypt(
            Illuminate\Cookie\CookieValuePrefix::create(\$n, \$e->getKey()).\$s->getId(), false));"

